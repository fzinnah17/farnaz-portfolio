---
import Layout from "../layouts/Layout.astro";

import ExpandableProjectCard from "../components/ExpandableProjectCard.astro";
import ExperienceLog from "../components/ExperienceLog.astro";
import FlowDiagram from "../components/FlowDiagram.astro";
import Hero from "../components/Hero.astro";
import PerformanceComparison from "../components/PerformanceComparison.astro";
import StackManifest from "../components/StackManifest.astro";
---

<Layout
  title="Farnaz Zinnah — AI Systems Engineer"
  description="AI systems, adversarial machine learning, systems performance, and AI governance."
>
  <main id="main" class="space-y-20 pb-28 md:space-y-24 lg:pb-20">
    <Hero />

    <!-- EXPERIENCE + STACK -->
    <section
      class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-2 lg:pr-12"
      aria-label="Experience and technical stack"
    >
      <div id="experience" class="scroll-mt-24 space-y-3">
        <h2
          class="border-b border-border pb-2 text-2xl font-bold tracking-tight text-text md:text-3xl"
        >
          Experience
        </h2>

        <p class="text-sm text-muted">Work and school, side by side.</p>

        <ExperienceLog />
      </div>

      <div id="stack" class="scroll-mt-24 space-y-3">
        <h2
          class="border-b border-border pb-2 text-2xl font-bold tracking-tight text-text md:text-3xl"
        >
          Stack
        </h2>

        <p class="text-sm text-muted">What I build with.</p>

        <StackManifest />
      </div>
    </section>

    <!-- SELECTED WORK -->
    <section
      id="work"
      class="mx-auto max-w-6xl scroll-mt-24 px-6 lg:pr-12"
      aria-labelledby="work-title"
    >
      <!-- Perspective-style section header -->
      <div class="grid border-y border-border md:grid-cols-[0.72fr_1.28fr]">
        <div class="border-b border-border px-5 py-6 md:border-b-0 md:border-r">
          <p class="text-[10px] uppercase tracking-[0.2em] text-royal">
            Work / 01
          </p>

          <h2
            id="work-title"
            class="mt-2 font-display text-3xl font-normal text-text"
          >
            Selected Work
          </h2>
        </div>

        <div class="flex items-end px-5 py-6">
          <p class="text-sm tracking-wide text-secondary">
            Build · break · review
          </p>
        </div>
      </div>

      <!-- PROJECTS -->
      <div class="grid auto-rows-min items-start gap-4 pt-6 md:grid-cols-3">
        <ExpandableProjectCard
          size="large"
          eyebrow="ML · Security"
          title="Adversarial Robustness Testing"
          hook="PGD cut classifier accuracy from 76% to 0.2%."
          details="Tested adversarial attacks on an ImageNet classifier. Cross-model transfer reached 90% at ε=8/255 over 20 PGD steps."
          stack={["PyTorch", "ImageNet-1K", "Security"]}
          href="https://github.com/fzinnah17/neural-network-jailbreak"
        />

        <ExpandableProjectCard
          eyebrow="Systems · Performance"
          title="Mojo vs CUDA"
          hook="Mojo led compute-bound work by 1.7–1.9×; CUDA led memory-bound work."
          details="The bottleneck changed the winner. That mattered more than the language itself."
          stack={["Mojo", "CUDA", "MAX Graph"]}
        >
          <PerformanceComparison slot="diagram" />
        </ExpandableProjectCard>

        <ExpandableProjectCard
          eyebrow="AI Systems"
          title="Agentic SDLC Automation"
          hook="Backlog → story draft → sync → retrieval."
          details="Agents draft first-pass stories, sync work items, and retrieve answers from sprint documentation."
          stack={["Azure OpenAI", "RAG", "Azure DevOps", "Python"]}
        >
          <FlowDiagram
            slot="diagram"
            steps={[
              { label: "Backlog" },
              { label: "Draft" },
              { label: "Sync" },
              { label: "Retrieve" },
            ]}
          />
        </ExpandableProjectCard>

        <ExpandableProjectCard
          eyebrow="AI Systems · Review"
          title="Board Materials Review Agent"
          hook="Document intake → rules → flagged review."
          details="Extracts document structure, checks explicit rules, and surfaces exceptions for human review."
          stack={["Azure OpenAI", "Storage", "Key Vault", "Python"]}
        >
          <FlowDiagram
            slot="diagram"
            steps={[
              { label: "Intake" },
              { label: "Extract" },
              { label: "Check" },
              { label: "Flag" },
              { label: "Review" },
            ]}
          />
        </ExpandableProjectCard>

        <ExpandableProjectCard
          eyebrow="AI · Governance"
          title="AI Governance Agent"
          hook="First-pass risk check before human review."
          details="Checks proposed AI use for data sensitivity, third-party exposure, and access-control risk."
          stack={["Gemini", "Vertex AI", "Python"]}
        />
      </div>

      <!-- PUBLIC DEMOS -->
      <div class="mt-6 grid border-y border-border sm:grid-cols-[10rem_1fr]">
        <div class="border-b border-border px-5 py-4 sm:border-b-0 sm:border-r">
          <p class="text-[10px] uppercase tracking-[0.18em] text-pewter">
            Public demos
          </p>
        </div>

        <div
          class="grid divide-y divide-border sm:grid-cols-2 sm:divide-x sm:divide-y-0"
        >
          <a
            href="https://github.com/fzinnah17/literature-screening-demo"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-4 transition-colors hover:text-royal"
          >
            <p class="text-sm font-medium">Literature screening ↗</p>

            <p class="mt-1 text-xs text-muted">Azure · structured outputs</p>
          </a>

          <a
            href="https://github.com/fzinnah17/ml-experiment-reporter"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-4 transition-colors hover:text-royal"
          >
            <p class="text-sm font-medium">Experiment reporter ↗</p>

            <p class="mt-1 text-xs text-muted">
              Vertex AI · experiment analysis
            </p>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
