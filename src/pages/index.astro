---
import Layout from "../layouts/Layout.astro";

import Hero from "../components/hero/Hero.astro";

import ExperienceLog from "../components/experience/ExperienceLog.astro";
import StackManifest from "../components/experience/StackManifest.astro";

import ArcheryTransition from "../components/work/ArcheryTransition.astro";
import ExpandableProjectCard from "../components/work/ExpandableProjectCard.astro";
import FlowDiagram from "../components/work/FlowDiagram.astro";
import PerformanceComparison from "../components/work/PerformanceComparison.astro";
import WorkGallery from "../components/work/WorkGallery.astro";

import FieldArchive from "../components/archive/FieldArchive.astro";
import WaltzInterlude from "../components/archive/WaltzInterlude.astro";

const publicProjects = [
  {
    title: "Adversarial Robustness Testing",
    href: "https://github.com/fzinnah17/neural-network-jailbreak",
    meta: "PyTorch · FGSM / PGD / patch robustness",
  },
  {
    title: "RoBERTa LoRA Fine-Tuning",
    href: "https://github.com/fzinnah17/LoRA-finetune-2025",
    meta: "RoBERTa · LoRA · 95.625% evaluation accuracy",
  },
  {
    title: "CIFAR-10 ResNet",
    href: "https://github.com/fzinnah17/cifar10-resnet-classification",
    meta: "Custom ResNet · SE · 92.72% validation",
  },
  {
    title: "Literature Screening",
    href: "https://github.com/fzinnah17/literature-screening-demo",
    meta: "Azure OpenAI · Entra ID · Pydantic",
  },
  {
    title: "ML Experiment Reporter",
    href: "https://github.com/fzinnah17/ml-experiment-reporter",
    meta: "Vertex AI · Gemini · structured analysis",
  },
  {
    title: "CapSure",
    href: "https://github.com/fzinnah17/CapSure",
    meta: "React · Vite · ApiFlash screenshot capture",
  },
  {
    title: "CodeFM",
    href: "https://github.com/fzinnah17/CodeFM",
    meta: "React · Express · PostgreSQL · GitHub OAuth",
  },
  {
    title: "MileMarker",
    href: "https://github.com/fzinnah17/MileMarker",
    meta: "React · Express · PostgreSQL · CRUD",
  },
  {
    title: "HackMapConnect",
    href: "https://github.com/fzinnah17/HackMapConnect",
    meta: "React · Express · PostgreSQL · event discovery",
  },
  {
    title: "UsageManagerApp",
    href: "https://github.com/fzinnah17/UsageManagerApp",
    meta: "Android · Java · usage analytics",
  },
] as const;
---

<Layout
  title="Farnaz Zinnah — AI Systems Engineer"
  description="AI systems, adversarial machine learning, systems performance, and AI governance."
>
  <main id="main" class="space-y-20 pb-28 md:space-y-24 lg:pb-20">
    <!-- ==================================================
         HERO
    ================================================== -->
    <Hero />

    <!-- ==================================================
         EXPERIENCE / 01
    ================================================== -->
    <section
      class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-2 lg:pr-12"
      aria-label="Experience and technical stack"
    >
      <!-- CHAPTER REGISTER -->
      <div
        class="col-span-full flex items-center gap-4 border-y border-border px-1 py-3"
      >
        <span class="text-[11px] uppercase tracking-[0.18em] text-royal">
          Experience / 01
        </span>

        <span aria-hidden="true" class="h-px flex-1 bg-border"></span>

        <span
          aria-hidden="true"
          class="h-1.5 w-1.5 rotate-45 border border-pewter"></span>
      </div>

      <!-- EXPERIENCE -->
      <div id="experience" class="scroll-mt-24 space-y-3">
        <h2
          class="border-b border-border pb-2 text-2xl font-bold tracking-tight text-text md:text-3xl"
        >
          Experience
        </h2>

        <p class="text-sm text-muted">Work and school, side by side.</p>

        <ExperienceLog />
      </div>

      <!-- STACK -->
      <div id="stack" class="scroll-mt-24 space-y-3">
        <h2
          class="border-b border-border pb-2 text-2xl font-bold tracking-tight text-text md:text-3xl"
        >
          Stack
        </h2>

        <p class="text-sm text-muted">What I build with.</p>

        <StackManifest />
      </div>
    </section>

    <!-- ==================================================
         WORK / 02
    ================================================== -->
    <div class="space-y-4">
      <!-- ONE-TIME ARCHERY TRANSITION -->
      <ArcheryTransition />

      <section
        id="work"
        class="mx-auto max-w-6xl scroll-mt-24 px-6 lg:pr-12"
        aria-label="Selected work"
      >
        <WorkGallery>
          <!-- 01 -->
          <div data-work-item data-category="ml-security" class="min-w-0">
            <ExpandableProjectCard
              eyebrow="ML · Security / 01"
              title="Adversarial Robustness Testing"
              hook="PGD reduced ResNet-34 top-1 accuracy from 76.0% to 0.2%."
              details="Generated FGSM, PGD, and localized-patch adversarial examples against ResNet-34 on a 500-image ImageNet subset, then evaluated the same perturbed inputs on DenseNet-121. PGD used ε=0.02 for 10 iterations and produced a 90.50% cross-model degradation ratio."
              stack={["PyTorch", "ResNet-34", "DenseNet-121", "ImageNet"]}
              href="https://github.com/fzinnah17/neural-network-jailbreak"
            />
          </div>

          <!-- 02 -->
          <div data-work-item data-category="systems" class="min-w-0">
            <ExpandableProjectCard
              eyebrow="Systems · Performance / 02"
              title="Mojo vs CUDA"
              hook="Mojo led compute-bound work by 1.7–1.9×; CUDA led memory-bound work."
              details="The bottleneck changed the winner."
              stack={["Mojo", "CUDA", "MAX Graph"]}
            >
              <PerformanceComparison slot="diagram" />
            </ExpandableProjectCard>
          </div>

          <!-- 03 -->
          <div data-work-item data-category="ai-systems" class="min-w-0">
            <ExpandableProjectCard
              eyebrow="AI Systems / 03"
              title="Agentic SDLC Automation"
              hook="Backlog → story draft → sync → retrieval."
              details="Agents draft stories, sync work items, and retrieve answers from sprint documentation."
              stack={["Azure OpenAI", "RAG", "Azure DevOps", "Python"]}
            >
              <FlowDiagram
                slot="diagram"
                steps={[
                  {
                    label: "Backlog",
                  },
                  {
                    label: "Draft",
                  },
                  {
                    label: "Sync",
                  },
                  {
                    label: "Retrieve",
                  },
                ]}
              />
            </ExpandableProjectCard>
          </div>

          <!-- 04 -->
          <div data-work-item data-category="ai-systems" class="min-w-0">
            <ExpandableProjectCard
              eyebrow="AI Systems · Review / 04"
              title="Board Materials Review Agent"
              hook="Document intake → rules → flagged review."
              details="Extracts structure, checks explicit rules, and surfaces exceptions for human review."
              stack={["Azure OpenAI", "Storage", "Key Vault", "Python"]}
            >
              <FlowDiagram
                slot="diagram"
                steps={[
                  {
                    label: "Intake",
                  },
                  {
                    label: "Extract",
                  },
                  {
                    label: "Check",
                  },
                  {
                    label: "Flag",
                  },
                  {
                    label: "Review",
                  },
                ]}
              />
            </ExpandableProjectCard>
          </div>

          <!-- 05 -->
          <div data-work-item data-category="ai-systems" class="min-w-0">
            <ExpandableProjectCard
              eyebrow="AI · Governance / 05"
              title="AI Governance Agent"
              hook="First-pass risk check before human review."
              details="Checks data sensitivity, third-party exposure, and access-control risk."
              stack={["Gemini", "Vertex AI", "Python"]}
            />
          </div>

          <!-- ==================================================
               PUBLIC PROJECT REGISTER
          ================================================== -->
          <ol
            slot="public"
            class="border-y border-border"
            aria-label="Public project repositories"
          >
            {
              publicProjects.map((project, index) => (
                <li class="border-b border-border last:border-b-0">
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.title} GitHub repository`}
                    class="grid gap-2 px-5 py-5 transition-colors duration-300 hover:bg-surface/40 sm:grid-cols-[3rem_18rem_1fr]"
                  >
                    <span class="font-mono text-[10px] tracking-[0.12em] text-royal">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <span class="font-display text-lg text-text">
                      {project.title} ↗
                    </span>

                    <span class="text-sm text-secondary">{project.meta}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </WorkGallery>
      </section>
    </div>

    <!-- ==================================================
         QUIET CEREMONIAL INTERLUDE

         Waltz lives HERE, not in Hero.
    ================================================== -->
    <div class="space-y-8">
      <WaltzInterlude />

      <!-- FIELD ARCHIVE / 03 -->
      <FieldArchive />
    </div>
  </main>
</Layout>
