---
import Layout from "../layouts/Layout.astro";
import ExpandableProjectCard from "../components/ExpandableProjectCard.astro";
import IdentityBlock from "../components/IdentityBlock.astro";
---

<Layout
  title="Farnaz Zinnah — AI Systems Engineer"
  description="AI Systems Engineer working across AI infrastructure, adversarial machine learning, distributed systems, and AI governance."
>
  <main
    class="mx-auto max-w-4xl space-y-20 px-6 pt-16 pb-28 md:pt-20 lg:pr-12 lg:pb-20"
  >
    <section
      class="grid min-h-[55vh] items-center gap-12 md:grid-cols-2"
      aria-labelledby="hero-title"
    >
      <div class="space-y-5">
        <p
          class="font-mono text-xs uppercase tracking-[0.18em] text-accent-cyan"
        >
          AI Systems · Security · Infrastructure
        </p>

        <h1
          id="hero-title"
          class="text-4xl font-bold leading-tight tracking-tight md:text-5xl"
        >
          Farnaz Zinnah
        </h1>

        <p class="max-w-md text-lg leading-8 text-paper/80">
          I build AI systems, break them on purpose to see how they fail, and
          help decide which ones are actually safe to ship.
        </p>

        <a
          href="#work"
          class="inline-flex items-center gap-2 border border-accent-cyan/50 px-4 py-2.5 font-mono text-sm text-accent-cyan transition-colors hover:border-accent-cyan hover:bg-accent-cyan/5"
        >
          See selected work
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <IdentityBlock />
    </section>

    <section
      id="experience"
      class="space-y-5"
      aria-labelledby="experience-title"
    >
      <div class="border-b border-white/10 pb-3">
        <p
          class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-accent-cyan"
        >
          Experience
        </p>

        <h2 id="experience-title" class="text-2xl font-semibold tracking-tight">
          Building AI systems in production.
        </h2>
      </div>

      <div class="space-y-3">
        <div
          class="flex flex-col gap-1 font-mono text-sm text-paper/60 sm:flex-row sm:items-center sm:justify-between"
        >
          <span class="text-paper/80"> Con Edison — AI Systems Engineer </span>

          <span> Dec 2022 – Present </span>
        </div>

        <p class="max-w-3xl leading-7 text-paper/80">
          Building and governing AI and automation systems in Enterprise
          Architecture, from production LLM pipelines to formal risk review of
          proposed AI deployments.
        </p>
      </div>

      <p class="border-t border-white/10 pt-4 text-sm text-paper/55">
        NYU Tandon, MS Computer Engineering (in progress)
        <span aria-hidden="true"> · </span>
        CCNY, BE Computer Engineering
      </p>
    </section>

    <section
      id="work"
      class="scroll-mt-24 space-y-6"
      aria-labelledby="work-title"
    >
      <div class="border-b border-white/10 pb-3">
        <p
          class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-accent-cyan"
        >
          Selected Work
        </p>

        <h2 id="work-title" class="text-2xl font-semibold tracking-tight">
          Things I have built, measured, and tried to break.
        </h2>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        <ExpandableProjectCard
          size="large"
          title="Adversarial Robustness Testing"
          hook="Dropped top-1 accuracy from 76% → 0.2% with perturbations too small to see."
          metric="76% → 0.2%"
          details="I wanted to know how easily a production-grade image classifier could be fooled. Turns out: very. A PGD attack dropped accuracy from 76% to 0.2%, and the attack transferred to a completely different architecture more than 90% of the time. Built solo in PyTorch and evaluated on ImageNet-1K."
          stack={["PyTorch", "ImageNet-1K", "FGSM", "PGD", "Security"]}
          href="https://github.com/fzinnah17/neural-network-jailbreak"
        />

        <ExpandableProjectCard
          title="Mojo vs CUDA"
          hook="Mojo's compiler-generated kernels beat cuBLAS by 1.7–1.9x on compute-heavy GEMM workloads."
          metric="1.7–1.9x"
          details="Mojo is still young, so I wanted to see how its compiler-generated GPU kernels actually stack up against CUDA's mature optimization stack. On compute-heavy operations, Mojo won by 1.7–1.9x. On memory-bound operations, CUDA still had the edge. Co-built for HPML coursework; my contribution focused on the MAX Graph baseline and PyTorch-to-MAX weight extraction pipeline."
          stack={["Mojo", "CUDA", "MAX Graph", "Transformer inference"]}
        />

        <ExpandableProjectCard
          title="Call Analytics Pipeline"
          hook="Cut manager review time from 6 hours → 1 hour per 100 calls."
          metric="6 hours → 1 hour"
          details="Managers were spending about six hours reviewing 100 customer service calls by hand. I built a speech-to-text and LLM pipeline that reduced that review time to about one hour and shortened feedback turnaround. The processing path is intentionally in-memory so audio and transcripts do not persist after processing."
          stack={["Python", "Azure Whisper", "GPT-4", "Concurrency"]}
        />

        <ExpandableProjectCard
          title="Cloud-to-On-Prem Gateway"
          hook="Replaced a 25-endpoint cap → unlimited code-based routing."
          metric="25-endpoint cap → unlimited"
          details="The previous method for connecting cloud applications to on-prem systems topped out at 25 endpoints. I built a code-based relay that can route to as many destinations as needed, handles more than one million requests a day, and stores routing rules separately so new routes can be added without changing application code."
          stack={["C# / .NET", "Azure Relay", "Table Storage", "Security"]}
        />
      </div>
    </section>

    <section
      id="governance"
      class="scroll-mt-24 border-y border-white/10 py-10"
      aria-labelledby="governance-title"
    >
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-xs uppercase tracking-[0.18em] text-accent-cyan"
        >
          Architecture &amp; Governance
        </p>

        <h2 id="governance-title" class="text-2xl font-semibold tracking-tight">
          The other side of the table.
        </h2>

        <p class="leading-8 text-paper/80">
          Part of my job is reviewing AI and automation systems before they
          ship, checking things like data sensitivity, PII exposure, third-party
          integrations, and access controls. The adversarial attacks work above
          feeds into this directly. It is hard to judge whether a model is safe
          to deploy if you have never tried to break one.
        </p>
      </div>
    </section>

    <section class="space-y-5" aria-labelledby="other-work-title">
      <div class="border-b border-white/10 pb-3">
        <p
          class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-accent-cyan"
        >
          Other Work
        </p>

        <h2 id="other-work-title" class="text-2xl font-semibold tracking-tight">
          Smaller systems, same curiosity.
        </h2>
      </div>

      <ul class="divide-y divide-white/10">
        <li class="grid gap-2 py-4 md:grid-cols-[12rem_1fr] md:gap-6">
          <span class="font-mono text-sm text-accent-cyan">
            SDLC automation
          </span>

          <span class="leading-7 text-paper/75">
            Multi-agent workflow for SharePoint ↔ ADO synchronization,
            AI-assisted story elaboration, and RAG-based QA.
          </span>
        </li>

        <li class="grid gap-2 py-4 md:grid-cols-[12rem_1fr] md:gap-6">
          <span class="font-mono text-sm text-accent-cyan">
            Infrastructure risk
          </span>

          <span class="leading-7 text-paper/75">
            Drone-imagery pipeline combining computer vision with weather data
            for infrastructure risk scoring on GCP.
          </span>
        </li>

        <li class="grid gap-2 py-4 md:grid-cols-[12rem_1fr] md:gap-6">
          <span class="font-mono text-sm text-accent-cyan">
            AI governance agent
          </span>

          <span class="leading-7 text-paper/75">
            Enterprise risk-classification tooling built with Gemini and Vertex
            AI.
          </span>
        </li>
      </ul>
    </section>

    <section
      class="border-y border-white/10 py-10"
      aria-labelledby="mentorship-title"
    >
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-xs uppercase tracking-[0.18em] text-accent-cyan"
        >
          Teaching &amp; Mentorship
        </p>

        <h2 id="mentorship-title" class="text-2xl font-semibold tracking-tight">
          Technical depth is better when it is shared.
        </h2>

        <p class="leading-8 text-paper/80">
          I've taught 50+ students data structures and clean code as a CodePath
          Tech Fellow, keeping a 94 NPS and getting renewed four semesters in a
          row. These days I mentor for CUNY Tech Prep's AI Ethics program, plus
          hackathons at HackMIT and Columbia DevFest.
        </p>
      </div>
    </section>
  </main>
</Layout>
