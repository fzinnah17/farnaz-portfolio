---
import { Image } from "astro:assets";
import fs from "node:fs";
import path from "node:path";

import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

import heroImage from "../assets/images/hero.jpg";
import aiSummitImage from "../assets/images/ai-summit.jpg";
import hackathonImage from "../assets/images/hackathon.jpg";

const hasResume = fs.existsSync(path.join(process.cwd(), "public", "resume.pdf"));

const projects = [
  {
    title: "Adversarial Robustness Testing",
    summary:
      "Built a framework to attack production-grade image classifiers (ResNet-34, DenseNet-121) using FGSM, PGD, and localized patch methods, measuring how easily models can be fooled by imperceptible pixel changes. PGD dropped top-1 accuracy from 76% to 0.2% while staying within a perturbation bound too small to see. Attacks transferred across architectures at 90%+ success, meaning an attacker wouldn't need access to the target model at all. Built solo in PyTorch, evaluated on ImageNet-1K.",
    stack: ["PyTorch", "ImageNet-1K", "FGSM / PGD", "Security"],
    href: "https://github.com/fzinnah17/neural-network-jailbreak",
  },
  {
    title: "Mojo vs CUDA: GPU Kernel Benchmarking",
    summary:
      "Co-built a benchmark comparing Mojo's emerging GPU compiler stack against PyTorch's mature CUDA backend on real Transformer inference workloads (GEMM, Softmax, LayerNorm). Found Mojo's compiler-generated kernels beat cuBLAS on compute-bound GEMM operations by 1.7–1.9x, while PyTorch stayed faster on memory-bound ops like LayerNorm. Net result: Mojo wins on large models where GEMM dominates runtime; PyTorch wins on small models where kernel overhead matters more. My contribution was the MAX-Graph baseline and PyTorch-to-MAX weight extraction pipeline.",
    stack: ["Mojo", "CUDA", "MAX Graph", "Transformer inference"],
  },
  {
    title: "Call Analytics Pipeline",
    summary:
      "Designed a speech-to-text + LLM pipeline for analyzing customer service calls at scale: Azure Whisper for transcription, GPT-4 for scoring and feedback generation, and multi-threaded batch processing with dynamic API key rotation. Cut manager review time from 6 hours to 1 hour per 100 calls and dropped feedback turnaround from 5–7 days to under 36 hours. The processing path is in-memory by design so audio and transcript data do not persist after a run.",
    stack: ["Python", "Azure Whisper", "GPT-4", "Concurrency"],
  },
  {
    title: "Cloud-to-On-Prem Routing Gateway",
    summary:
      "Built a dynamic reverse proxy connecting cloud applications to on-prem systems, replacing a portal-based connection method capped at 25 endpoints with a code-based relay that routes to unlimited destinations. Routing rules live in a cache-aside table store instead of hardcoded config, so new routes deploy without a code push. Handles 1M+ daily requests with validation against path traversal and protocol downgrade attacks at the middleware layer.",
    stack: ["C# / .NET", "Azure Relay", "Table Storage", "Security"],
  },
];
---

<Layout title="Farnaz Zinnah — AI Systems Engineer">
  <header class="sticky top-0 z-50 border-b backdrop-blur-xl" style="border-color: var(--border); background: color-mix(in srgb, var(--bg) 84%, transparent);">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 md:px-8" aria-label="Primary navigation">
      <a href="#top" class="font-mono text-sm font-semibold tracking-tight">FZ<span class="text-accent-cyan">.</span></a>
      <div class="flex items-center gap-1 sm:gap-3">
        <a href="#work" class="hidden rounded-full px-3 py-2 text-sm sm:inline-block muted hover:text-current">Work</a>
        <a href="#governance" class="hidden rounded-full px-3 py-2 text-sm md:inline-block muted hover:text-current">Governance</a>
        <a href="#contact" class="hidden rounded-full px-3 py-2 text-sm sm:inline-block muted hover:text-current">Contact</a>
        <ThemeToggle />
      </div>
    </nav>
  </header>

  <main id="top" class="mx-auto max-w-6xl px-5 pb-24 pt-16 md:px-8 md:pt-24">
    <section class="grid min-h-[68vh] items-center gap-12 lg:grid-cols-[1.25fr_0.75fr]" aria-labelledby="hero-title">
      <div class="max-w-3xl">
        <p class="mb-5 font-mono text-xs uppercase tracking-[0.22em] text-accent-cyan">AI systems · security · infrastructure</p>
        <h1 id="hero-title" class="text-5xl font-bold tracking-[-0.045em] sm:text-6xl lg:text-7xl">Farnaz Zinnah</h1>
        <p class="mt-6 max-w-2xl text-xl leading-8 sm:text-2xl sm:leading-9">
          AI Systems Engineer — <span class="text-gradient font-semibold">building, breaking, and governing</span> AI systems.
        </p>
        <p class="muted mt-5 text-sm sm:text-base">NYU Tandon · MS Computer Engineering (in progress)</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#work" class="rounded-full bg-gradient-to-r from-accent-violet to-accent-cyan px-5 py-2.5 text-sm font-semibold text-white transition hover:-translate-y-0.5">See selected work</a>
          <a href="https://github.com/fzinnah17" target="_blank" rel="noreferrer" class="rounded-full border px-5 py-2.5 text-sm font-semibold transition hover:-translate-y-0.5" style="border-color: var(--border-strong);">GitHub ↗</a>
        </div>
      </div>

      <ScrollReveal rotate={2} class="mx-auto w-full max-w-sm lg:ml-auto">
        <figure class="surface overflow-hidden rounded-[1.75rem] p-2">
          <Image src={heroImage} alt="Placeholder for Farnaz's portfolio hero photo" widths={[480, 720]} sizes="(max-width: 1024px) 80vw, 360px" class="aspect-[4/5] w-full rounded-[1.35rem] object-cover" loading="eager" />
          <figcaption class="muted px-3 pb-2 pt-3 font-mono text-[11px]">Replace: src/assets/images/hero.jpg</figcaption>
        </figure>
      </ScrollReveal>
    </section>

    <section id="work" class="scroll-mt-24 py-24 md:py-32" aria-labelledby="work-title">
      <div class="mb-10 flex items-end justify-between gap-6 border-b pb-4" style="border-color: var(--border);">
        <div>
          <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.18em] text-accent-cyan">01 / Selected Work</p>
          <h2 id="work-title" class="text-3xl font-semibold tracking-tight md:text-4xl">Systems that ship — and systems that fail safely.</h2>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </section>

    <section id="governance" class="scroll-mt-24 grid gap-10 py-24 md:py-32 lg:grid-cols-[1.1fr_0.9fr] lg:items-center" aria-labelledby="governance-title">
      <div>
        <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.18em] text-accent-cyan">02 / Architecture &amp; Governance</p>
        <h2 id="governance-title" class="text-3xl font-semibold tracking-tight md:text-4xl">AI Architecture &amp; Governance Review</h2>
        <p class="muted mt-6 text-base leading-8 md:text-lg">
          Sit on the review side of AI deployment decisions — evaluating proposed AI and automation systems against risk criteria before they ship: data sensitivity, PII/PHI exposure, third-party integration risk, and on-prem access controls. The adversarial attacks work above is not unrelated to this: understanding how models fail is what makes evaluating whether one is safe to deploy possible in the first place.
        </p>
      </div>

      <ScrollReveal rotate={-2} class="mx-auto w-full max-w-lg">
        <figure class="surface overflow-hidden rounded-[1.75rem] p-2">
          <Image src={aiSummitImage} alt="Placeholder for an AI conference or architecture photo" widths={[560, 900]} sizes="(max-width: 1024px) 90vw, 440px" class="aspect-[4/3] w-full rounded-[1.35rem] object-cover" />
          <figcaption class="muted px-3 pb-2 pt-3 font-mono text-[11px]">Replace: src/assets/images/ai-summit.jpg</figcaption>
        </figure>
      </ScrollReveal>
    </section>

    <section class="py-24 md:py-32" aria-labelledby="other-work-title">
      <div class="mb-8 border-b pb-4" style="border-color: var(--border);">
        <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.18em] text-accent-cyan">03 / Other Work</p>
        <h2 id="other-work-title" class="text-3xl font-semibold tracking-tight md:text-4xl">More things I have built.</h2>
      </div>

      <div class="grid gap-4">
        <div class="rounded-2xl border p-5 md:grid md:grid-cols-[0.35fr_1fr] md:gap-8" style="border-color: var(--border); background: var(--surface);">
          <p class="font-mono text-xs text-accent-cyan">SDLC automation</p>
          <p class="muted mt-2 leading-7 md:mt-0">Multi-agent workflow for SharePoint↔ADO synchronization, AI-assisted story elaboration, and RAG-based QA.</p>
        </div>
        <div class="rounded-2xl border p-5 md:grid md:grid-cols-[0.35fr_1fr] md:gap-8" style="border-color: var(--border); background: var(--surface);">
          <p class="font-mono text-xs text-accent-cyan">Infrastructure risk</p>
          <p class="muted mt-2 leading-7 md:mt-0">Drone imagery risk pipeline combining computer vision with weather data for infrastructure risk scoring on GCP.</p>
        </div>
        <div class="rounded-2xl border p-5 md:grid md:grid-cols-[0.35fr_1fr] md:gap-8" style="border-color: var(--border); background: var(--surface);">
          <p class="font-mono text-xs text-accent-cyan">AI governance</p>
          <p class="muted mt-2 leading-7 md:mt-0">Enterprise AI governance agent for risk classification using Gemini and Vertex AI.</p>
        </div>
      </div>
    </section>

    <section class="grid gap-10 py-24 md:py-32 lg:grid-cols-[0.85fr_1.15fr] lg:items-center" aria-labelledby="mentorship-title">
      <ScrollReveal rotate={2} class="order-2 mx-auto w-full max-w-lg lg:order-1">
        <figure class="surface overflow-hidden rounded-[1.75rem] p-2">
          <Image src={hackathonImage} alt="Placeholder for a hackathon or teaching photo" widths={[560, 900]} sizes="(max-width: 1024px) 90vw, 440px" class="aspect-[4/3] w-full rounded-[1.35rem] object-cover" />
          <figcaption class="muted px-3 pb-2 pt-3 font-mono text-[11px]">Replace: src/assets/images/hackathon.jpg</figcaption>
        </figure>
      </ScrollReveal>

      <div class="order-1 lg:order-2">
        <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.18em] text-accent-cyan">04 / Teaching &amp; Mentorship</p>
        <h2 id="mentorship-title" class="text-3xl font-semibold tracking-tight md:text-4xl">Technical depth is better when it is shared.</h2>
        <p class="muted mt-6 text-base leading-8 md:text-lg">
          Taught data structures, clean code, and design patterns to 50+ students as a CodePath Tech Fellow, hitting a 94 NPS and getting the contract renewed four semesters straight. Currently an AI Ethics Mentor with CUNY Tech Prep and a hackathon mentor for HackMIT and Columbia DevFest.
        </p>
      </div>
    </section>

    <section id="contact" class="scroll-mt-24 py-24 text-center md:py-32" aria-labelledby="contact-title">
      <div class="surface mx-auto max-w-3xl rounded-3xl px-6 py-12 md:px-12 md:py-16">
        <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.18em] text-accent-cyan">05 / Contact</p>
        <h2 id="contact-title" class="text-3xl font-semibold tracking-tight md:text-4xl">Want to talk systems, ML infrastructure, or model security?</h2>
        <p class="muted mx-auto mt-5 max-w-xl leading-7">I am always interested in thoughtful engineering work where reliability, security, and AI meet.</p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="mailto:farnazsamia@gmail.com" class="rounded-full border px-4 py-2 text-sm font-medium transition hover:-translate-y-0.5" style="border-color: var(--border-strong);">Email</a>
          <a href="https://linkedin.com/in/farnaz-zinnah" target="_blank" rel="noreferrer" class="rounded-full border px-4 py-2 text-sm font-medium transition hover:-translate-y-0.5" style="border-color: var(--border-strong);">LinkedIn ↗</a>
          <a href="https://github.com/fzinnah17" target="_blank" rel="noreferrer" class="rounded-full border px-4 py-2 text-sm font-medium transition hover:-translate-y-0.5" style="border-color: var(--border-strong);">GitHub ↗</a>
          {hasResume ? (
            <a href="/resume.pdf" download class="rounded-full bg-gradient-to-r from-accent-violet to-accent-cyan px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5">Download Resume</a>
          ) : (
            <span class="cursor-not-allowed rounded-full border px-4 py-2 text-sm muted" style="border-color: var(--border);" title="Add public/resume.pdf to enable this link">Resume: add PDF</span>
          )}
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t" style="border-color: var(--border);">
    <div class="muted mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-xs sm:flex-row sm:items-center sm:justify-between md:px-8">
      <p>© {new Date().getFullYear()} Farnaz Zinnah.</p>
      <p class="font-mono">Astro · Tailwind · static by default</p>
    </div>
  </footer>
</Layout>
