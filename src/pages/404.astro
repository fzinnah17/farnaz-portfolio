---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 — Farnaz Zinnah"
  description="The requested route could not be found."
>
  <main
    id="main"
    class="mx-auto flex min-h-[70vh] max-w-4xl flex-col items-center justify-center space-y-4 px-6 text-center"
  >
    <p class="font-mono text-sm text-accent-cyan">status: 404</p>

    <h1 class="text-3xl font-bold">This route doesn't exist.</h1>

    <p class="text-secondary">Probably a bad link, not a bad deploy.</p>

    <a href="/" class="font-mono text-sm text-accent-cyan hover:underline">
      ← back to /
    </a>
  </main>
</Layout>
