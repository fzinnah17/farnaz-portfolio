---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Farnaz Zinnah">
  <main class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-20 text-center">
    <div class="w-full">
      <p class="font-mono text-sm uppercase tracking-[0.2em] text-accent-cyan">404</p>
      <h1 class="mt-4 text-5xl font-bold tracking-tight">That route does not exist.</h1>
      <p class="muted mx-auto mt-5 max-w-xl text-lg leading-8">The page may have moved, or the link may be wrong.</p>
      <a href="/" class="mt-8 inline-block rounded-full bg-gradient-to-r from-accent-violet to-accent-cyan px-5 py-2.5 text-sm font-semibold text-white">Back to portfolio</a>
    </div>
  </main>
</Layout>
