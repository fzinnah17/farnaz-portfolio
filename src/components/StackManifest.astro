---
const dependencies = [
    ["torch", "adversarial ML, PGD and FGSM attacks"],
    ["mojo", "GPU kernels and CUDA benchmarking"],
    ["azure-openai", "production LLM pipelines"],
    ["azure-table-storage", "caching and dynamic routing"],
    ["google-cloud-vision", "multimodal detection pipelines"],
    ["rag-agents", "retrieval and agent orchestration"],
];
---

<div
    class="overflow-x-auto rounded-lg border border-paper/10 bg-paper/[0.03] p-5 font-mono text-xs leading-7 sm:text-sm"
>
    <div class="mb-2 text-paper/50"># stack.txt</div>

    {
        dependencies.map(([technology, note]) => (
            <div class="min-w-max">
                <span class="text-accent-violet">{technology}</span>
                <span class="text-paper/60">
                    {"  # "}
                    {note}
                </span>
            </div>
        ))
    }
</div>
