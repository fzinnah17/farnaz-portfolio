---
const azure = [
    {
        label: "Azure AI Foundry",
        detail: "Managed model deployment and inference endpoints for production AI pipelines.",
    },
    {
        label: "Azure OpenAI + Document Intelligence",
        detail: "LLM-based document review and structured rule-checking workflows.",
    },
    {
        label: "Azure Key Vault",
        detail: "Runtime secret resolution so credentials never need to live in application code.",
    },
    {
        label: "Blob & Table Storage",
        detail: "Short-lived intake storage and cache-aside routing configuration.",
    },
    {
        label: "Azure DevOps + Terraform",
        detail: "Deployment pipelines and infrastructure provisioned as code.",
    },
    {
        label: "Computer Vision",
        detail: "Image and infrastructure analysis workflows.",
    },
] as const;

const gcp = [
    {
        label: "Vertex AI + Gemini",
        detail: "AI governance and risk-classification workflows.",
    },
    {
        label: "Cloud Vision API",
        detail: "Object localization and image analysis for infrastructure workflows.",
    },
    {
        label: "Video Intelligence",
        detail: "Object tracking and video-level analysis.",
    },
    {
        label: "Cloud Storage",
        detail: "Object storage for image and video pipelines.",
    },
    {
        label: "GCP architecture review",
        detail: "Experience reviewing cloud data-platform architecture, controls, and deployment considerations before production use.",
    },
] as const;
---

<div class="grid gap-4 md:grid-cols-2">
    <article class="rounded-sm border border-border bg-surface p-5">
        <h3
            class="text-xs font-semibold uppercase tracking-[0.17em] text-pewter"
        >
            Azure
        </h3>

        <ul class="mt-5 space-y-4">
            {
                azure.map((item) => (
                    <li>
                        <p class="font-medium text-text">{item.label}</p>

                        <p class="mt-1 text-sm leading-6 text-secondary">
                            {item.detail}
                        </p>
                    </li>
                ))
            }
        </ul>
    </article>

    <article class="rounded-sm border border-border bg-surface p-5">
        <h3
            class="text-xs font-semibold uppercase tracking-[0.17em] text-pewter"
        >
            GCP
        </h3>

        <ul class="mt-5 space-y-4">
            {
                gcp.map((item) => (
                    <li>
                        <p class="font-medium text-text">{item.label}</p>

                        <p class="mt-1 text-sm leading-6 text-secondary">
                            {item.detail}
                        </p>
                    </li>
                ))
            }
        </ul>
    </article>
</div>
