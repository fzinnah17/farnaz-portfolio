<button
    type="button"
    data-theme-toggle
    aria-label="Switch to light theme"
    class="flex h-9 w-9 items-center justify-center rounded border border-border font-mono text-xs text-secondary transition-colors hover:border-accent-cyan hover:text-accent-cyan"
>
    <span data-theme-icon aria-hidden="true"> ☼ </span>
</button>

<script>
    const toggle = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
    );

    const icon = document.querySelector<HTMLElement>("[data-theme-icon]");

    function syncThemeButton() {
        if (!toggle || !icon) {
            return;
        }

        const dark = document.documentElement.classList.contains("dark");

        icon.textContent = dark ? "☼" : "☾";

        toggle.setAttribute(
            "aria-label",
            dark ? "Switch to light theme" : "Switch to dark theme",
        );
    }

    if (toggle) {
        syncThemeButton();

        toggle.addEventListener("click", () => {
            const root = document.documentElement;

            root.classList.toggle("dark");

            const dark = root.classList.contains("dark");

            localStorage.setItem("theme", dark ? "dark" : "light");

            syncThemeButton();
        });
    }
</script>
