---
const buildDate = new Date().toISOString().slice(0, 10);
---

<footer class="mx-auto max-w-6xl px-6 py-10 text-center">
    <p class="font-mono text-xs tracking-wide text-paper/60">
        Crafted by Farnaz Zinnah
        <span aria-hidden="true"> · </span>
        © 2026
        <span class="text-accent-violet" aria-hidden="true">♥</span>
    </p>

    <p class="mt-1 font-mono text-[10px] text-paper/40">
        build {buildDate}
    </p>
</footer>
