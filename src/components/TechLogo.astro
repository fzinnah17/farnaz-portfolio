---
interface Props {
    slug: string;
    label: string;
}

const { slug, label } = Astro.props;
---

<div class="flex items-center gap-2">
    <img
        src={`https://cdn.simpleicons.org/${slug}`}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        width="16"
        height="16"
        class="h-4 w-4 shrink-0 opacity-80"
    />

    <span class="text-sm font-medium text-text">
        {label}
    </span>
</div>
