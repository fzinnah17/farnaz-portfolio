---
const fields = [
    ["role", "AI Systems Engineer"],
    ["at Con Edison since", "Dec 2022"],
    [
        "currently curious about",
        "distributed systems, adversarial ML, AI governance",
    ],
    ["status", "building something new"],
] as const;
---

<div data-identity-block>
    <span class="sr-only">
        AI Systems Engineer at Con Edison since December 2022. Currently curious
        about distributed systems, adversarial machine learning, and AI
        governance. Status: building something new.
    </span>

    <div
        aria-hidden="true"
        class="rounded-lg border border-border bg-surface p-4 font-mono text-xs leading-7 text-text sm:p-6 sm:text-sm"
    >
        <div class="text-muted">
            {"{"}
        </div>

        {
            fields.map(([key, value], index) => (
                <div class="pl-4">
                    <span class="text-accent-cyan">"{key}"</span>

                    <span class="text-muted">: "</span>

                    <span data-typed-value data-value={value}>
                        {value}
                    </span>

                    <span
                        data-typed-cursor
                        hidden
                        class="animate-pulse text-accent-cyan"
                    >
                        ▍
                    </span>

                    <span class="text-muted">
                        "{index < fields.length - 1 ? "," : ""}
                    </span>
                </div>
            ))
        }

        <div class="text-muted">
            {"}"}
        </div>
    </div>
</div>

<script>
    const block = document.querySelector<HTMLElement>("[data-identity-block]");

    if (block) {
        initializeIdentityBlock(block);
    }

    function sleep(milliseconds: number) {
        return new Promise<void>((resolve) => {
            window.setTimeout(resolve, milliseconds);
        });
    }

    async function initializeIdentityBlock(block: HTMLElement) {
        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        );

        const values = Array.from(
            block.querySelectorAll<HTMLElement>("[data-typed-value]"),
        );

        const cursors = Array.from(
            block.querySelectorAll<HTMLElement>("[data-typed-cursor]"),
        );

        if (reducedMotion.matches) {
            return;
        }

        for (const value of values) {
            value.textContent = "";
        }

        await sleep(250);

        for (let index = 0; index < values.length; index += 1) {
            const value = values[index];
            const cursor = cursors[index];

            if (!value) {
                continue;
            }

            const text = value.dataset.value ?? "";

            if (cursor) {
                cursor.hidden = false;
            }

            await sleep(180);

            for (let position = 1; position <= text.length; position += 1) {
                value.textContent = text.slice(0, position);

                await sleep(45);
            }

            if (cursor) {
                cursor.hidden = true;
            }

            await sleep(220);
        }
    }
</script>
