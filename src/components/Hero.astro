---
import { Image } from "astro:assets";

import avatarImage from "../assets/portfolio/avatar.jpg";
---

<section
    class="mx-auto grid min-h-[68vh] max-w-6xl items-center gap-10 px-6 py-14 md:grid-cols-[1fr_1.15fr] md:gap-16 md:py-20 lg:pr-12"
    aria-labelledby="hero-title"
>
    <!-- PORTRAIT
       Light mode = color
       Dark mode = grayscale
  -->
    <div class="order-2 md:order-1">
        <Image
            src={avatarImage}
            alt="Farnaz Zinnah"
            width={420}
            height={504}
            loading="eager"
            class="hero-portrait mx-auto aspect-[5/6] w-full max-w-[380px] object-cover md:mx-0"
        />
    </div>

    <!-- HERO CONTENT -->
    <div class="order-1 max-w-2xl space-y-7 md:order-2">
        <div class="space-y-3">
            <p class="text-xs uppercase tracking-[0.16em] text-muted">
                AI Systems · Security · Infrastructure
            </p>

            <h1
                id="hero-title"
                class="font-display text-5xl font-normal leading-none tracking-tight text-text md:text-6xl"
            >
                Farnaz Zinnah
            </h1>

            <p class="text-lg text-secondary">AI Systems Engineer</p>
        </div>

        <p class="max-w-xl text-lg leading-8 text-text md:text-xl">
            I build AI systems, break them on purpose to understand failure
            modes, and help decide which systems are safe to ship.
        </p>

        <dl
            class="grid max-w-2xl grid-cols-2 gap-x-8 gap-y-5 border-y border-border py-5 sm:grid-cols-3"
        >
            <div>
                <dt class="text-xs uppercase tracking-[0.12em] text-muted">
                    Platforms
                </dt>

                <dd class="mt-1 text-sm font-medium text-text">Azure · GCP</dd>
            </div>

            <div>
                <dt class="text-xs uppercase tracking-[0.12em] text-muted">
                    Focus
                </dt>

                <dd class="mt-1 text-sm font-medium text-text">
                    AI systems · risk
                </dd>
            </div>

            <div>
                <dt class="text-xs uppercase tracking-[0.12em] text-muted">
                    Experience
                </dt>

                <dd class="mt-1 text-sm font-medium text-text">
                    Con Edison · 2022—
                </dd>
            </div>
        </dl>

        <button
            type="button"
            data-scroll-target="worklab"
            data-activate-tab="work"
            class="inline-flex min-h-[44px] items-center gap-2 border-b border-accent-strong pb-0.5 text-sm font-medium text-text transition-colors duration-500 hover:border-text"
        >
            Selected work

            <span aria-hidden="true"> ↓ </span>
        </button>
    </div>
</section>

<style>
    /*
   * Light mode:
   * preserve the photograph's original color.
   */
    .hero-portrait {
        filter: none;
        transition: filter 180ms ease;
    }

    /*
   * Dark mode:
   * use the restrained black-and-white treatment.
   *
   * This follows the same html.dark class already used by
   * the site's theme system, so no additional JavaScript is needed.
   */
    :global(html.dark) .hero-portrait {
        filter: grayscale(1) contrast(1.05);
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-portrait {
            transition: none;
        }
    }
</style>
