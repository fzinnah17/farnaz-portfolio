---
import { Image } from "astro:assets";

import avatarImage from "../assets/portfolio/avatar.jpg";
---

<section
    class="mx-auto grid min-h-[66vh] max-w-6xl items-center gap-10 px-6 py-14 md:grid-cols-[0.95fr_1.15fr] md:gap-16 md:py-20 lg:pr-12"
    aria-labelledby="hero-title"
>
    <!-- PORTRAIT -->
    <div class="order-2 md:order-1">
        <div class="mx-auto max-w-[365px] md:mx-0">
            <Image
                src={avatarImage}
                alt="Farnaz Zinnah"
                width={410}
                height={492}
                loading="eager"
                class="hero-portrait aspect-[5/6] w-full object-cover"
            />
        </div>
    </div>

    <!-- IDENTITY -->
    <div class="order-1 max-w-2xl space-y-7 md:order-2">
        <div class="space-y-3">
            <p class="text-xs uppercase tracking-[0.18em] text-muted">
                AI Systems · Security · Infrastructure
            </p>

            <h1
                id="hero-title"
                class="font-display text-5xl font-normal leading-none tracking-tight text-text md:text-6xl"
            >
                Farnaz Zinnah
            </h1>

            <p class="text-lg text-secondary">AI Systems Engineer</p>
        </div>

        <p class="max-w-xl text-lg leading-8 text-text md:text-xl">
            I build AI systems, break them on purpose to understand failure
            modes, and help decide which systems are safe to ship.
        </p>

        <dl
            class="grid max-w-2xl grid-cols-2 gap-x-8 gap-y-5 border-y border-border py-5 sm:grid-cols-3"
        >
            <div>
                <dt class="text-xs uppercase tracking-[0.13em] text-muted">
                    Platforms
                </dt>

                <dd class="mt-1 text-sm font-medium text-text">Azure · GCP</dd>
            </div>

            <div>
                <dt class="text-xs uppercase tracking-[0.13em] text-muted">
                    Focus
                </dt>

                <dd class="mt-1 text-sm font-medium text-text">
                    AI systems · risk
                </dd>
            </div>

            <div>
                <dt class="text-xs uppercase tracking-[0.13em] text-muted">
                    Experience
                </dt>

                <dd class="mt-1 text-sm font-medium text-text">
                    Con Edison · 2022—
                </dd>
            </div>
        </dl>

        <div class="space-y-4">
            <button
                type="button"
                data-scroll-target="worklab"
                data-activate-tab="work"
                class="inline-flex min-h-[44px] items-center gap-2 border-b border-pewter pb-0.5 text-sm font-medium text-text transition-colors duration-500 hover:border-text"
            >
                Selected work

                <span aria-hidden="true"> ↓ </span>
            </button>

            <!-- Quiet craftsmanship / accessibility mark -->
            <p
                class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] uppercase tracking-[0.14em] text-muted sm:text-[11px]"
            >
                <span>Accessible by design</span>

                <span class="text-border" aria-hidden="true"> · </span>

                <span>Keyboard</span>

                <span class="text-border" aria-hidden="true"> · </span>

                <span>Screen readers</span>

                <span class="text-border" aria-hidden="true"> · </span>

                <span>Reduced motion</span>
            </p>
        </div>
    </div>
</section>

<style>
    /*
   * Light mode:
   * preserve the original color photograph.
   */
    .hero-portrait {
        filter: none;

        transition: filter 220ms ease;
    }

    /*
   * Dark mode:
   * controlled black-and-white portrait.
   */
    :global(html.dark) .hero-portrait {
        filter: grayscale(1) contrast(1.04);
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-portrait {
            transition: none;
        }
    }
</style>
