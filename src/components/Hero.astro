---
import { Image } from "astro:assets";

import avatarImage from "../assets/portfolio/avatar.jpg";

import ArchitectureField from "./ArchitectureField.astro";
import IdentityBlock from "./IdentityBlock.astro";
import NakhwaTransition from "./NakhwaTransition.astro";
---

<section
    class="relative isolate mx-auto grid min-h-[72vh] max-w-6xl items-center gap-10 overflow-hidden px-6 py-14 md:grid-cols-[0.92fr_1.08fr] md:gap-16 md:py-20 lg:pr-12"
    aria-labelledby="hero-title"
>
    <!-- ENGINEERING MOTIF -->
    <ArchitectureField />

    <!--
    PERFECT CROWN MOTIF

    The Nakhwa effect remains invisible until
    Selected work or Header Work is triggered.
  -->
    <NakhwaTransition />

    <!-- PORTRAIT -->
    <div class="relative z-10 order-2 md:order-1">
        <div class="mx-auto max-w-[350px] md:mx-0">
            <Image
                src={avatarImage}
                alt="Farnaz Zinnah"
                width={400}
                height={480}
                loading="eager"
                class="hero-portrait aspect-[5/6] w-full object-cover"
            />
        </div>
    </div>

    <!-- IDENTITY -->
    <div class="relative z-10 order-1 max-w-2xl space-y-6 md:order-2">
        <div class="space-y-3">
            <p class="text-[11px] uppercase tracking-[0.2em] text-pewter">
                AI Systems · Security · Infrastructure
            </p>

            <h1
                id="hero-title"
                class="font-display text-5xl font-normal leading-none tracking-tight text-text md:text-6xl"
            >
                Farnaz Zinnah
            </h1>

            <div class="flex items-center gap-3">
                <span aria-hidden="true" class="h-px w-8 bg-royal"></span>

                <p class="text-base text-secondary sm:text-lg">
                    AI Systems Engineer
                </p>
            </div>
        </div>

        <p class="max-w-xl text-lg leading-8 text-text md:text-xl">
            I build AI systems, break them on purpose to understand failure
            modes, and help decide which systems are safe to ship.
        </p>

        <!-- ANIMATED SYSTEM DOSSIER -->
        <div class="max-w-xl">
            <IdentityBlock />
        </div>

        <div class="flex flex-col items-start gap-3">
            <!--
        No href="#work":
        keeps the browser URL clean.

        data-section-scroll handles navigation.
        data-nakhwa-trigger plays the Nakhwa effect.
      -->
            <button
                type="button"
                data-section-scroll="work"
                data-nakhwa-trigger
                class="group inline-flex min-h-[44px] items-center gap-3 text-sm font-medium text-text"
            >
                <span
                    class="border-b border-pewter pb-0.5 transition-colors duration-500 group-hover:border-royal"
                >
                    Selected work
                </span>

                <span
                    aria-hidden="true"
                    class="text-royal transition-transform duration-500 group-hover:translate-y-0.5"
                >
                    ↓
                </span>
            </button>

            <!-- ACCESSIBILITY MAKER'S MARK -->
            <p
                class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[9px] uppercase tracking-[0.15em] text-muted sm:text-[10px]"
            >
                <span> Accessible by design </span>

                <span aria-hidden="true" class="text-border"> · </span>

                <span> Keyboard </span>

                <span aria-hidden="true" class="text-border"> · </span>

                <span> Screen readers </span>

                <span aria-hidden="true" class="text-border"> · </span>

                <span> Reduced motion </span>
            </p>
        </div>
    </div>
</section>

<style>
    /*
   * LIGHT MODE
   *
   * Keep the portrait in color but slightly restrained
   * so it fits the tailored editorial treatment.
   */
    .hero-portrait {
        filter: saturate(0.86) contrast(1.035) brightness(0.985);

        transition: filter 240ms ease;
    }

    /*
   * DARK MODE
   *
   * Restrained monochrome portrait.
   */
    :global(html.dark) .hero-portrait {
        filter: grayscale(1) contrast(1.045) brightness(0.96);
    }

    /*
   * Accessibility.
   */
    @media (prefers-reduced-motion: reduce) {
        .hero-portrait {
            transition: none;
        }
    }
</style>
