---
const demos = [
    {
        name: "literature-screening-demo",
        description:
            "Azure structured outputs over fictional research abstracts.",
        href: "https://github.com/fzinnah17/literature-screening-demo",
    },
    {
        name: "ml-experiment-reporter",
        description:
            "Vertex AI structured analysis over synthetic ML experiment metrics.",
        href: "https://github.com/fzinnah17/ml-experiment-reporter",
    },
] as const;
---

<section
    id="perspective"
    class="scroll-mt-24"
    aria-labelledby="perspective-title"
>
    <div class="grid border-y border-border md:grid-cols-[0.72fr_1.28fr]">
        <!-- FORMAL TITLE COLUMN -->
        <div class="border-b border-border px-5 py-7 md:border-b-0 md:border-r">
            <p class="text-[10px] uppercase tracking-[0.2em] text-royal">
                Perspective / 01
            </p>

            <h2
                id="perspective-title"
                class="mt-3 font-display text-3xl font-normal text-text"
            >
                Technical range,
                <br />
                not one platform.
            </h2>

            <p class="mt-4 max-w-sm text-sm leading-6 text-secondary">
                The tool changes with the constraint. The engineering question
                comes first.
            </p>
        </div>

        <!-- RANGE -->
        <div class="divide-y divide-border">
            <div class="grid gap-4 px-5 py-5 sm:grid-cols-[9rem_1fr]">
                <p class="text-[10px] uppercase tracking-[0.16em] text-pewter">
                    ML + Security
                </p>

                <p class="text-sm leading-6 text-secondary">
                    Adversarial robustness · failure modes · model evaluation
                </p>
            </div>

            <div class="grid gap-4 px-5 py-5 sm:grid-cols-[9rem_1fr]">
                <p class="text-[10px] uppercase tracking-[0.16em] text-pewter">
                    Systems
                </p>

                <p class="text-sm leading-6 text-secondary">
                    GPU kernels · throughput · compute-vs-memory bottlenecks
                </p>
            </div>

            <div class="grid gap-4 px-5 py-5 sm:grid-cols-[9rem_1fr]">
                <p class="text-[10px] uppercase tracking-[0.16em] text-pewter">
                    Cloud + Agents
                </p>

                <p class="text-sm leading-6 text-secondary">
                    Azure · GCP · model orchestration · RAG
                </p>
            </div>
        </div>
    </div>

    <!-- PUBLIC PROOF -->
    <div
        class="grid gap-5 border-b border-border px-5 py-5 sm:grid-cols-[9rem_1fr]"
    >
        <p class="text-[10px] uppercase tracking-[0.16em] text-pewter">
            Public demos
        </p>

        <div class="flex flex-col gap-3 sm:flex-row sm:gap-7">
            {
                demos.map((demo) => (
                    <div class="max-w-sm">
                        <a
                            href={demo.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-medium text-text transition-colors duration-500 hover:text-royal"
                        >
                            {demo.name}
                            <span aria-hidden="true"> ↗</span>
                        </a>

                        <p class="mt-1 text-xs leading-5 text-muted">
                            {demo.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
