---
interface Props {
    size?: "sm" | "md";
}

const { size = "sm" } = Astro.props;
---

<span class="jewel-mark" data-size={size} aria-hidden="true">
    <span class="jewel-halo"></span>
    <span class="jewel-core"></span>
</span>

<style>
    /*
   * Abstracted from the emerald-cut + pavé
   * geometry of the engagement ring.
   *
   * Deliberately NOT a literal ring icon.
   */

    .jewel-mark {
        position: relative;

        display: inline-grid;

        flex: none;

        place-items: center;

        width: 16px;
        height: 13px;
    }

    .jewel-mark[data-size="md"] {
        width: 22px;
        height: 18px;
    }

    .jewel-halo,
    .jewel-core {
        position: absolute;

        clip-path: polygon(
            18% 0,
            82% 0,
            100% 20%,
            100% 80%,
            82% 100%,
            18% 100%,
            0 80%,
            0 20%
        );
    }

    /*
   * Pavé-like outer geometry.
   */
    .jewel-halo {
        inset: 0;

        background: linear-gradient(
            135deg,
            #f7f8f8,
            #aeb7c0 42%,
            #eef1f3 62%,
            #7f8993
        );

        opacity: 0.88;
    }

    /*
   * Emerald-cut center.
   */
    .jewel-core {
        inset: 2px;

        background: linear-gradient(
            135deg,
            #ffffff,
            #dce4e9 35%,
            #aab7c1 62%,
            #f8fafb
        );

        box-shadow: inset 0 0 0 1px rgba(68, 78, 88, 0.28);
    }

    :global(html.dark) .jewel-halo {
        background: linear-gradient(
            135deg,
            #dce4e9,
            #6e7985 44%,
            #c8d1d8 64%,
            #48535f
        );
    }

    :global(html.dark) .jewel-core {
        background: linear-gradient(
            135deg,
            #f2f5f7,
            #aebac4 42%,
            #687681 64%,
            #d8e0e5
        );
    }
</style>
