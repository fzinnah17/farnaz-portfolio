---
const criteria = [
    {
        marker: "01",
        label: "Data sensitivity",
        note: "What data moves through it?",
    },
    {
        marker: "02",
        label: "PII / PHI",
        note: "Is personal or health data exposed?",
    },
    {
        marker: "03",
        label: "Third-party risk",
        note: "What can vendors or APIs access?",
    },
    {
        marker: "04",
        label: "Access controls",
        note: "Who can reach the system?",
    },
] as const;
---

<div class="divide-y divide-border border-y border-border">
    {
        criteria.map((criterion) => (
            <div class="grid gap-2 px-5 py-4 sm:grid-cols-[2rem_12rem_1fr]">
                <span class="font-mono text-[10px] text-royal">
                    {criterion.marker}
                </span>

                <span class="text-sm font-medium text-text">
                    {criterion.label}
                </span>

                <span class="text-sm text-secondary">{criterion.note}</span>
            </div>
        ))
    }
</div>
