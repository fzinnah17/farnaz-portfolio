---
interface Step {
    label: string;
}

interface Props {
    steps: Step[];
}

const { steps } = Astro.props;
---

<div class="mt-4 overflow-x-auto" aria-label="System flow">
    <div class="flex min-w-max items-center gap-2 py-2">
        {
            steps.map((step, index) => (
                <>
                    <div class="shrink-0 rounded border border-border bg-surface px-3 py-1.5 font-mono text-xs text-text">
                        {step.label}
                    </div>

                    {index < steps.length - 1 && (
                        <span class="shrink-0 text-muted" aria-hidden="true">
                            →
                        </span>
                    )}
                </>
            ))
        }
    </div>
</div>
