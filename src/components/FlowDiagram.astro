---
interface Step {
    label: string;
}

interface Props {
    steps: Step[];
}

const { steps } = Astro.props;
---

<div
    class="mt-4 overflow-x-auto border-y border-border"
    aria-label="System flow"
>
    <ol class="flex min-w-max items-center py-3">
        {
            steps.map((step, index) => (
                <li class="flex items-center">
                    <span class="px-3 font-mono text-[10px] uppercase tracking-[0.12em] text-pewter">
                        {step.label}
                    </span>

                    {index < steps.length - 1 && (
                        <span class="text-royal" aria-hidden="true">
                            →
                        </span>
                    )}
                </li>
            ))
        }
    </ol>
</div>
