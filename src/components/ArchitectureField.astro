<canvas
    data-architecture-field
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 hidden h-full w-full opacity-70 sm:block"
></canvas>

<script>
    interface DiagramBox {
        x: number;
        y: number;
        w: number;
        h: number;
        label: string;
    }

    interface Connection {
        from: number;
        to: number;
    }

    interface Point {
        x: number;
        y: number;
    }

    const labels = [
        "api",
        "queue",
        "cache",
        "auth",
        "worker",
        "db",
        "gateway",
        "cdn",
        "logs",
        "storage",
    ];

    const canvas = document.querySelector<HTMLCanvasElement>(
        "[data-architecture-field]",
    );

    if (canvas) {
        const context = canvas.getContext("2d");

        const container = canvas.parentElement;

        if (context && container) {
            initializeArchitectureField(canvas, context, container);
        }
    }

    function initializeArchitectureField(
        canvas: HTMLCanvasElement,
        context: CanvasRenderingContext2D,
        container: HTMLElement,
    ) {
        const motionPreference = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        );

        const relativeBoxes = [
            {
                x: 0.04,
                y: 0.16,
                w: 0.14,
                h: 0.08,
            },
            {
                x: 0.29,
                y: 0.08,
                w: 0.14,
                h: 0.08,
            },
            {
                x: 0.54,
                y: 0.18,
                w: 0.14,
                h: 0.08,
            },
            {
                x: 0.79,
                y: 0.1,
                w: 0.14,
                h: 0.08,
            },
            {
                x: 0.14,
                y: 0.45,
                w: 0.14,
                h: 0.08,
            },
            {
                x: 0.41,
                y: 0.5,
                w: 0.14,
                h: 0.08,
            },
            {
                x: 0.67,
                y: 0.42,
                w: 0.14,
                h: 0.08,
            },
            {
                x: 0.82,
                y: 0.62,
                w: 0.14,
                h: 0.08,
            },
            {
                x: 0.24,
                y: 0.78,
                w: 0.14,
                h: 0.08,
            },
            {
                x: 0.57,
                y: 0.82,
                w: 0.14,
                h: 0.08,
            },
        ];

        const connections: Connection[] = [
            { from: 0, to: 1 },
            { from: 1, to: 2 },
            { from: 2, to: 3 },
            { from: 0, to: 4 },
            { from: 1, to: 5 },
            { from: 5, to: 6 },
            { from: 6, to: 7 },
            { from: 4, to: 8 },
            { from: 5, to: 9 },
            { from: 2, to: 6 },
        ];

        let width = 0;
        let height = 0;
        let boxes: DiagramBox[] = [];
        let animationId = 0;

        function themeColors() {
            const dark = document.documentElement.classList.contains("dark");

            return dark
                ? {
                      box: "rgba(124,58,237,0.42)",
                      fill: "rgba(124,58,237,0.07)",
                      line: "rgba(6,182,212,0.30)",
                      pulse: "rgba(6,182,212,0.95)",
                      label: "rgba(246,245,241,0.65)",
                  }
                : {
                      box: "rgba(109,40,217,0.38)",
                      fill: "rgba(109,40,217,0.06)",
                      line: "rgba(14,116,144,0.36)",
                      pulse: "rgba(14,116,144,0.95)",
                      label: "rgba(23,24,28,0.68)",
                  };
        }

        function layout() {
            boxes = relativeBoxes.map((box, index) => ({
                x: box.x * width,
                y: box.y * height,
                w: box.w * width,
                h: box.h * height,
                label: labels[index] ?? "node",
            }));
        }

        function buildPath(first: DiagramBox, second: DiagramBox): Point[] {
            const startX = first.x + first.w / 2;

            const startY = first.y + first.h / 2;

            const endX = second.x + second.w / 2;

            const endY = second.y + second.h / 2;

            const middleX = startX + (endX - startX) * 0.5;

            return [
                {
                    x: startX,
                    y: startY,
                },
                {
                    x: middleX,
                    y: startY,
                },
                {
                    x: middleX,
                    y: endY,
                },
                {
                    x: endX,
                    y: endY,
                },
            ];
        }

        function drawArrow(previous: Point, end: Point, color: string) {
            const angle = Math.atan2(end.y - previous.y, end.x - previous.x);

            const size = 5;

            context.fillStyle = color;

            context.beginPath();

            context.moveTo(end.x, end.y);

            context.lineTo(
                end.x - size * Math.cos(angle - Math.PI / 6),
                end.y - size * Math.sin(angle - Math.PI / 6),
            );

            context.lineTo(
                end.x - size * Math.cos(angle + Math.PI / 6),
                end.y - size * Math.sin(angle + Math.PI / 6),
            );

            context.closePath();
            context.fill();
        }

        function drawConnection(points: Point[], color: string) {
            const first = points[0];

            if (!first) {
                return;
            }

            context.strokeStyle = color;
            context.lineWidth = 1;

            context.beginPath();
            context.moveTo(first.x, first.y);

            for (const point of points.slice(1)) {
                context.lineTo(point.x, point.y);
            }

            context.stroke();

            const end = points.at(-1);

            const previous = points.at(-2);

            if (end && previous) {
                drawArrow(previous, end, color);
            }
        }

        function pointAlongPath(points: Point[], progress: number): Point {
            const lengths: number[] = [];

            let total = 0;

            for (let index = 0; index < points.length - 1; index += 1) {
                const start = points[index];

                const end = points[index + 1];

                if (!start || !end) {
                    continue;
                }

                const length = Math.hypot(end.x - start.x, end.y - start.y);

                lengths.push(length);
                total += length;
            }

            let target = progress * total;

            for (let index = 0; index < lengths.length; index += 1) {
                const length = lengths[index];

                const start = points[index];

                const end = points[index + 1];

                if (length === undefined || !start || !end) {
                    continue;
                }

                if (target <= length) {
                    const fraction = length === 0 ? 0 : target / length;

                    return {
                        x: start.x + (end.x - start.x) * fraction,

                        y: start.y + (end.y - start.y) * fraction,
                    };
                }

                target -= length;
            }

            return (
                points.at(-1) ?? {
                    x: 0,
                    y: 0,
                }
            );
        }

        function draw(time: number) {
            const colors = themeColors();

            context.clearRect(0, 0, width, height);

            const paths: Point[][] = [];

            for (const connection of connections) {
                const from = boxes[connection.from];

                const to = boxes[connection.to];

                if (!from || !to) {
                    continue;
                }

                const path = buildPath(from, to);

                paths.push(path);

                drawConnection(path, colors.line);
            }

            for (const box of boxes) {
                context.fillStyle = colors.fill;

                context.strokeStyle = colors.box;

                context.lineWidth = 1;

                context.beginPath();

                context.roundRect(box.x, box.y, box.w, box.h, 4);

                context.fill();
                context.stroke();

                context.fillStyle = colors.label;

                context.font = "10px ui-monospace, monospace";

                context.textAlign = "center";

                context.textBaseline = "middle";

                context.fillText(
                    box.label,
                    box.x + box.w / 2,
                    box.y + box.h / 2,
                );
            }

            if (!motionPreference.matches) {
                paths.forEach((path, index) => {
                    const progress = (time * 0.00006 + index * 0.13) % 1;

                    const point = pointAlongPath(path, progress);

                    context.fillStyle = colors.pulse;

                    context.beginPath();

                    context.arc(point.x, point.y, 2, 0, Math.PI * 2);

                    context.fill();
                });

                animationId = requestAnimationFrame(draw);
            }
        }

        function resize() {
            cancelAnimationFrame(animationId);

            const rect = container.getBoundingClientRect();

            const dpr = Math.min(window.devicePixelRatio || 1, 2);

            width = Math.max(1, rect.width);

            height = Math.max(1, rect.height);

            canvas.width = Math.round(width * dpr);

            canvas.height = Math.round(height * dpr);

            canvas.style.width = `${width}px`;

            canvas.style.height = `${height}px`;

            context.setTransform(dpr, 0, 0, dpr, 0, 0);

            layout();

            draw(performance.now());
        }

        const resizeObserver = new ResizeObserver(resize);

        const themeObserver = new MutationObserver(() => {
            if (motionPreference.matches) {
                draw(0);
            }
        });

        resizeObserver.observe(container);

        themeObserver.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });

        motionPreference.addEventListener("change", resize);

        resize();

        window.addEventListener(
            "pagehide",
            () => {
                cancelAnimationFrame(animationId);

                resizeObserver.disconnect();
                themeObserver.disconnect();

                motionPreference.removeEventListener("change", resize);
            },
            {
                once: true,
            },
        );
    }
</script>
