---
type IconName =
    | "mail"
    | "code"
    | "link"
    | "document"
    | "shield"
    | "check"
    | "layers"
    | "eye"
    | "briefcase"
    | "graduation";

interface Props {
    name: IconName;
    class?: string;
}

const { name, class: className = "" } = Astro.props;

const paths: Record<IconName, string> = {
    mail: "M3 6h18v12H3V6zm0 0l9 7 9-7",

    code: "M8 4L3 12l5 8M16 4l5 8-5 8",

    link: "M10 14a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07l-1.5 1.5M14 10a5 5 0 0 0-7.07 0L4.1 12.83a5 5 0 0 0 7.07 7.07l1.5-1.5",

    document: "M6 2h9l5 5v15H6V2zM14 2v6h6",

    shield: "M12 2L4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5l-8-3z",

    check: "M5 13l4 4L19 7",

    layers: "M12 2L2 7l10 5 10-5-10-5M2 12l10 5 10-5M2 17l10 5 10-5",

    eye: "M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z",

    briefcase: "M4 7h16v12H4V7zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2",

    graduation: "M2 9l10-5 10 5-10 5-10-5zM6 11v5c0 1 3 3 6 3s6-2 6-3v-5",
};
---

<svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
>
    <path d={paths[name]}></path>
</svg>
