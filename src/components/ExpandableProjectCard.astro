---
interface Props {
    eyebrow?: string;
    title: string;
    hook: string;
    details: string;
    stack: string[];
    href?: string;
}

const { eyebrow, title, hook, details, stack, href } = Astro.props;
---

<article
    class="project-card relative h-fit min-w-0 border border-border bg-surface/55 p-5"
>
    <!-- restrained formal corner mark -->
    <span
        aria-hidden="true"
        class="project-corner absolute -left-px -top-px h-px w-8 bg-royal"
    ></span>

    <span
        aria-hidden="true"
        class="project-corner absolute -left-px -top-px h-8 w-px bg-royal"
    ></span>

    {
        eyebrow && (
            <p class="mb-2 text-[9px] uppercase tracking-[0.19em] text-pewter">
                {eyebrow}
            </p>
        )
    }

    <h3 class="font-display text-xl font-semibold tracking-tight text-text">
        {title}
    </h3>

    <p class="mt-2 text-sm leading-6 text-secondary">
        {hook}
    </p>

    <details data-project-details class="group mt-4">
        <summary
            class="flex w-fit cursor-pointer list-none items-center gap-2 py-1 text-xs text-pewter transition-colors duration-300 hover:text-text"
        >
            <span
                aria-hidden="true"
                class="text-royal transition-transform duration-300 group-open:rotate-90"
            >
                ▸
            </span>

            details
        </summary>

        <div class="mt-3 border-t border-border pt-4">
            <p class="text-sm leading-6 text-text">
                {details}
            </p>

            <slot name="diagram" />

            <ul
                class="mt-4 flex flex-wrap gap-x-3 gap-y-1"
                aria-label={`${title} technology stack`}
            >
                {
                    stack.map((item) => (
                        <li class="font-mono text-[10px] text-muted">{item}</li>
                    ))
                }
            </ul>

            {
                href && (
                    <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-text transition-colors duration-300 hover:text-royal"
                    >
                        View code
                        <span aria-hidden="true">↗</span>
                    </a>
                )
            }
        </div>
    </details>
</article>

<style>
    .project-card {
        transition:
            border-color 300ms ease,
            background-color 300ms ease,
            box-shadow 300ms ease;
    }

    .project-corner {
        opacity: 0.32;

        transition:
            opacity 300ms ease,
            width 300ms ease,
            height 300ms ease;
    }

    .project-card:hover {
        border-color: color-mix(
            in srgb,
            var(--theme-pewter) 58%,
            var(--theme-border)
        );
    }

    .project-card:has(details[open]) {
        border-color: color-mix(
            in srgb,
            var(--theme-pewter) 75%,
            var(--theme-border)
        );

        box-shadow: 0 18px 50px rgba(16, 20, 28, 0.06);
    }

    .project-card:has(details[open]) .project-corner {
        opacity: 0.85;
    }

    :global(html.dark) .project-card:has(details[open]) {
        box-shadow: 0 22px 60px rgba(0, 0, 0, 0.2);
    }
</style>
