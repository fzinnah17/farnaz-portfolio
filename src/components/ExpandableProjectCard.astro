---
interface Props {
    eyebrow?: string;
    title: string;
    hook: string;
    details: string;
    stack: string[];
    metric?: string;
    href?: string;
    size?: "large" | "small";
}

const {
    eyebrow,
    title,
    hook,
    details,
    stack,
    metric,
    href,
    size = "small",
} = Astro.props;

const spanClass = size === "large" ? "md:col-span-2" : "";

const metricIndex = metric ? hook.indexOf(metric) : -1;

const hookBefore =
    metric && metricIndex >= 0 ? hook.slice(0, metricIndex) : hook;

const hookAfter =
    metric && metricIndex >= 0 ? hook.slice(metricIndex + metric.length) : "";
---

<article
    class:list={[
        "self-start h-fit min-w-0 border border-border bg-surface/60 p-5 transition-colors duration-500 hover:border-pewter",
        spanClass,
    ]}
>
    {
        eyebrow && (
            <p class="mb-2 text-[9px] uppercase tracking-[0.17em] text-pewter">
                {eyebrow}
            </p>
        )
    }

    <h3 class="text-lg font-semibold tracking-tight text-text">
        {title}
    </h3>

    <p class="mt-2 text-sm leading-6 text-secondary">
        {hookBefore}

        {
            metric && metricIndex >= 0 && (
                <strong class="font-semibold text-text">{metric}</strong>
            )
        }

        {hookAfter}
    </p>

    <details name="portfolio-project" data-project-details class="group mt-4">
        <summary
            class="flex cursor-pointer list-none items-center gap-2 text-xs text-pewter transition-colors hover:text-text"
        >
            <span
                aria-hidden="true"
                class="text-royal transition-transform duration-300 group-open:rotate-90"
            >
                ▸
            </span>

            details
        </summary>

        <div class="mt-4 border-t border-border pt-4">
            <p class="text-sm leading-6 text-text">
                {details}
            </p>

            <slot name="diagram" />

            <ul
                class="mt-4 flex flex-wrap gap-x-3 gap-y-1"
                aria-label={`${title} technology stack`}
            >
                {
                    stack.map((item) => (
                        <li class="font-mono text-[10px] text-muted">{item}</li>
                    ))
                }
            </ul>

            {
                href && (
                    <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-text transition-colors hover:text-royal"
                    >
                        View code ↗
                    </a>
                )
            }
        </div>
    </details>
</article>

<script>
    /*
     * Keep project expansion exclusive even in browsers where
     * named <details> accordion behavior differs.
     */
    document.addEventListener(
        "toggle",
        (event) => {
            const opened = event.target;

            if (
                !(opened instanceof HTMLDetailsElement) ||
                !opened.matches("[data-project-details]") ||
                !opened.open
            ) {
                return;
            }

            document
                .querySelectorAll<HTMLDetailsElement>("[data-project-details]")
                .forEach((details) => {
                    if (details !== opened) {
                        details.open = false;
                    }
                });
        },
        true,
    );
</script>
