---
type Platform = "Azure" | "GCP";

interface Props {
    title: string;
    hook: string;
    details: string;
    stack: string[];
    platforms?: Platform[];
    metric?: string;
    href?: string;
    size?: "large" | "small";
}

const {
    title,
    hook,
    details,
    stack,
    platforms = [],
    metric,
    href,
    size = "small",
} = Astro.props;

const spanClass = size === "large" ? "md:col-span-2" : "";

const metricIndex = metric ? hook.indexOf(metric) : -1;

const hookBefore =
    metric && metricIndex >= 0 ? hook.slice(0, metricIndex) : hook;

const hookAfter =
    metric && metricIndex >= 0 ? hook.slice(metricIndex + metric.length) : "";
---

<article
    class:list={[
        "self-start h-fit rounded-lg border border-border bg-surface p-5 transition-[transform,border-color] hover:-translate-y-0.5 hover:border-accent-violet",
        spanClass,
    ]}
>
    <div class="flex items-start justify-between gap-3">
        <h3 class="text-lg font-semibold tracking-tight text-text">
            {title}
        </h3>

        {
            platforms.length > 0 && (
                <div
                    class="flex shrink-0 flex-wrap justify-end gap-1.5"
                    aria-label="Cloud platforms"
                >
                    {platforms.map((platform) => (
                        <span class="rounded border border-border px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wide text-muted">
                            {platform}
                        </span>
                    ))}
                </div>
            )
        }
    </div>

    <p class="mt-2 text-sm leading-6 text-secondary">
        {hookBefore}

        {
            metric && metricIndex >= 0 && (
                <strong class="font-semibold text-text">{metric}</strong>
            )
        }

        {hookAfter}
    </p>

    <details class="group mt-4">
        <summary
            class="flex cursor-pointer list-none items-center gap-1.5 font-mono text-xs text-accent-cyan"
        >
            <span
                aria-hidden="true"
                class="transition-transform group-open:rotate-90"
            >
                ▸
            </span>

            details
        </summary>

        <div class="mt-4 border-t border-border pt-4">
            <p class="text-sm leading-7 text-text">
                {details}
            </p>

            <slot name="diagram" />

            <ul
                class="mt-4 flex flex-wrap gap-2"
                aria-label={`${title} technology stack`}
            >
                {
                    stack.map((item) => (
                        <li class="rounded border border-border px-2 py-1 font-mono text-[11px] text-muted">
                            {item}
                        </li>
                    ))
                }
            </ul>

            {
                href && (
                    <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent-cyan hover:underline"
                    >
                        View code
                        <span aria-hidden="true">↗</span>
                    </a>
                )
            }
        </div>
    </details>
</article>
