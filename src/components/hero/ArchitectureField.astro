<canvas
    data-architecture-field
    aria-hidden="true"
    class="architecture-field pointer-events-none absolute inset-0 z-0 hidden h-full w-full sm:block"
></canvas>

<style>
    .architecture-field {
        opacity: 0.58;

        /*
     * Keep the portrait side quiet.
     * The system gradually appears behind the right side.
     */
        -webkit-mask-image: linear-gradient(
            to right,
            transparent 0%,
            transparent 26%,
            rgba(0, 0, 0, 0.35) 42%,
            black 68%,
            black 100%
        );

        mask-image: linear-gradient(
            to right,
            transparent 0%,
            transparent 26%,
            rgba(0, 0, 0, 0.35) 42%,
            black 68%,
            black 100%
        );
    }

    :global(html:not(.dark)) .architecture-field {
        opacity: 0.68;
    }
</style>

<script>
    interface DiagramBox {
        x: number;
        y: number;
        w: number;
        h: number;
        label: string;
    }

    interface Connection {
        from: number;
        to: number;
    }

    interface Point {
        x: number;
        y: number;
    }

    const labels = [
        "gateway",
        "policy",
        "model",
        "queue",
        "review",
        "vault",
        "storage",
        "audit",
    ];

    const canvas = document.querySelector<HTMLCanvasElement>(
        "[data-architecture-field]",
    );

    if (canvas) {
        const context = canvas.getContext("2d");

        const container = canvas.parentElement;

        if (context && container) {
            initializeArchitectureField(canvas, context, container);
        }
    }

    function initializeArchitectureField(
        canvas: HTMLCanvasElement,
        context: CanvasRenderingContext2D,
        container: HTMLElement,
    ) {
        const motionPreference = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        );

        /*
         * More formal and balanced than the old scattered layout.
         * Think architectural plan rather than floating SaaS nodes.
         */
        const relativeBoxes = [
            {
                x: 0.26,
                y: 0.13,
                w: 0.13,
                h: 0.065,
            },
            {
                x: 0.47,
                y: 0.08,
                w: 0.13,
                h: 0.065,
            },
            {
                x: 0.68,
                y: 0.13,
                w: 0.13,
                h: 0.065,
            },
            {
                x: 0.3,
                y: 0.4,
                w: 0.13,
                h: 0.065,
            },
            {
                x: 0.47,
                y: 0.35,
                w: 0.13,
                h: 0.065,
            },
            {
                x: 0.64,
                y: 0.4,
                w: 0.13,
                h: 0.065,
            },
            {
                x: 0.37,
                y: 0.73,
                w: 0.13,
                h: 0.065,
            },
            {
                x: 0.58,
                y: 0.73,
                w: 0.13,
                h: 0.065,
            },
        ];

        const connections: Connection[] = [
            {
                from: 0,
                to: 1,
            },
            {
                from: 1,
                to: 2,
            },
            {
                from: 0,
                to: 3,
            },
            {
                from: 1,
                to: 4,
            },
            {
                from: 2,
                to: 5,
            },
            {
                from: 3,
                to: 4,
            },
            {
                from: 4,
                to: 5,
            },
            {
                from: 3,
                to: 6,
            },
            {
                from: 4,
                to: 7,
            },
            {
                from: 6,
                to: 7,
            },
        ];

        let width = 0;
        let height = 0;

        let boxes: DiagramBox[] = [];

        let animationId = 0;

        function themeColors() {
            const dark = document.documentElement.classList.contains("dark");

            return dark
                ? {
                      box: "rgba(146,154,166,0.30)",
                      fill: "rgba(16,20,28,0.35)",
                      line: "rgba(146,154,166,0.17)",
                      axis: "rgba(182,75,91,0.10)",
                      pulse: "rgba(182,75,91,0.88)",
                      corner: "rgba(182,75,91,0.38)",
                      label: "rgba(241,237,230,0.40)",
                  }
                : {
                      box: "rgba(93,104,115,0.34)",
                      fill: "rgba(250,248,243,0.52)",
                      line: "rgba(93,104,115,0.26)",
                      axis: "rgba(122,36,51,0.13)",
                      pulse: "rgba(122,36,51,0.72)",
                      corner: "rgba(122,36,51,0.42)",
                      label: "rgba(21,22,26,0.44)",
                  };
        }

        function layout() {
            boxes = relativeBoxes.map((box, index) => ({
                x: box.x * width,

                y: box.y * height,

                w: box.w * width,

                h: box.h * height,

                label: labels[index] ?? "node",
            }));
        }

        function buildPath(first: DiagramBox, second: DiagramBox): Point[] {
            const startX = first.x + first.w / 2;

            const startY = first.y + first.h / 2;

            const endX = second.x + second.w / 2;

            const endY = second.y + second.h / 2;

            const middleY = startY + (endY - startY) * 0.5;

            return [
                {
                    x: startX,
                    y: startY,
                },
                {
                    x: startX,
                    y: middleY,
                },
                {
                    x: endX,
                    y: middleY,
                },
                {
                    x: endX,
                    y: endY,
                },
            ];
        }

        function drawArrow(previous: Point, end: Point, color: string) {
            const angle = Math.atan2(
                end.y - previous.y,

                end.x - previous.x,
            );

            const size = 4;

            context.fillStyle = color;

            context.beginPath();

            context.moveTo(end.x, end.y);

            context.lineTo(
                end.x - size * Math.cos(angle - Math.PI / 6),

                end.y - size * Math.sin(angle - Math.PI / 6),
            );

            context.lineTo(
                end.x - size * Math.cos(angle + Math.PI / 6),

                end.y - size * Math.sin(angle + Math.PI / 6),
            );

            context.closePath();
            context.fill();
        }

        function drawConnection(points: Point[], color: string) {
            const first = points[0];

            if (!first) {
                return;
            }

            context.strokeStyle = color;

            context.lineWidth = 1;

            context.beginPath();

            context.moveTo(first.x, first.y);

            for (const point of points.slice(1)) {
                context.lineTo(point.x, point.y);
            }

            context.stroke();

            const end = points.at(-1);

            const previous = points.at(-2);

            if (end && previous) {
                drawArrow(previous, end, color);
            }
        }

        function drawCornerMarks(box: DiagramBox, color: string) {
            const size = 7;

            context.strokeStyle = color;

            context.lineWidth = 1;

            /*
             * Upper-left rank mark.
             */
            context.beginPath();

            context.moveTo(box.x, box.y + size);

            context.lineTo(box.x, box.y);

            context.lineTo(box.x + size, box.y);

            context.stroke();

            /*
             * Lower-right balance mark.
             */
            context.beginPath();

            context.moveTo(box.x + box.w - size, box.y + box.h);

            context.lineTo(box.x + box.w, box.y + box.h);

            context.lineTo(box.x + box.w, box.y + box.h - size);

            context.stroke();
        }

        function pointAlongPath(points: Point[], progress: number): Point {
            const lengths: number[] = [];

            let total = 0;

            for (let index = 0; index < points.length - 1; index += 1) {
                const start = points[index];

                const end = points[index + 1];

                if (!start || !end) {
                    continue;
                }

                const length = Math.hypot(
                    end.x - start.x,

                    end.y - start.y,
                );

                lengths.push(length);

                total += length;
            }

            let target = progress * total;

            for (let index = 0; index < lengths.length; index += 1) {
                const length = lengths[index];

                const start = points[index];

                const end = points[index + 1];

                if (length === undefined || !start || !end) {
                    continue;
                }

                if (target <= length) {
                    const fraction = length === 0 ? 0 : target / length;

                    return {
                        x: start.x + (end.x - start.x) * fraction,

                        y: start.y + (end.y - start.y) * fraction,
                    };
                }

                target -= length;
            }

            return (
                points.at(-1) ?? {
                    x: 0,
                    y: 0,
                }
            );
        }

        function draw(time: number) {
            const colors = themeColors();

            context.clearRect(0, 0, width, height);

            /*
             * Subtle center line gives the whole drawing
             * the formal symmetry of an architectural plan.
             */
            context.strokeStyle = colors.axis;

            context.lineWidth = 1;

            context.beginPath();

            context.moveTo(width * 0.535, height * 0.03);

            context.lineTo(width * 0.535, height * 0.92);

            context.stroke();

            const paths: Point[][] = [];

            for (const connection of connections) {
                const from = boxes[connection.from];

                const to = boxes[connection.to];

                if (!from || !to) {
                    continue;
                }

                const path = buildPath(from, to);

                paths.push(path);

                drawConnection(path, colors.line);
            }

            for (const box of boxes) {
                context.fillStyle = colors.fill;

                context.strokeStyle = colors.box;

                context.lineWidth = 1;

                /*
                 * Deliberately square.
                 * No SaaS rounded rectangle.
                 */
                context.fillRect(box.x, box.y, box.w, box.h);

                context.strokeRect(box.x, box.y, box.w, box.h);

                drawCornerMarks(box, colors.corner);

                context.fillStyle = colors.label;

                context.font = "9px ui-monospace, monospace";

                context.textAlign = "center";

                context.textBaseline = "middle";

                context.fillText(
                    box.label.toUpperCase(),
                    box.x + box.w / 2,

                    box.y + box.h / 2,
                );
            }

            /*
             * Slow, deliberate movement.
             * Not a busy network animation.
             */
            if (!motionPreference.matches) {
                paths.forEach((path, index) => {
                    const progress = (time * 0.000025 + index * 0.17) % 1;

                    const point = pointAlongPath(path, progress);

                    context.fillStyle = colors.pulse;

                    context.beginPath();

                    context.arc(point.x, point.y, 1.75, 0, Math.PI * 2);

                    context.fill();
                });

                animationId = requestAnimationFrame(draw);
            }
        }

        function resize() {
            cancelAnimationFrame(animationId);

            const rect = container.getBoundingClientRect();

            const dpr = Math.min(window.devicePixelRatio || 1, 2);

            width = Math.max(1, rect.width);

            height = Math.max(1, rect.height);

            canvas.width = Math.round(width * dpr);

            canvas.height = Math.round(height * dpr);

            canvas.style.width = `${width}px`;

            canvas.style.height = `${height}px`;

            context.setTransform(dpr, 0, 0, dpr, 0, 0);

            layout();

            draw(performance.now());
        }

        const resizeObserver = new ResizeObserver(resize);

        const themeObserver = new MutationObserver(() => {
            if (motionPreference.matches) {
                draw(0);
            }
        });

        resizeObserver.observe(container);

        themeObserver.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });

        motionPreference.addEventListener("change", resize);

        resize();

        window.addEventListener(
            "pagehide",
            () => {
                cancelAnimationFrame(animationId);

                resizeObserver.disconnect();

                themeObserver.disconnect();

                motionPreference.removeEventListener("change", resize);
            },
            {
                once: true,
            },
        );
    }
</script>
