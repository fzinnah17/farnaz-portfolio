---
import ThemeToggle from "./ThemeToggle.astro";
---

<header
    class="sticky top-0 z-30 border-b border-border bg-bg/95 backdrop-blur-sm"
>
    <nav
        class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 lg:pr-12"
        aria-label="Primary navigation"
    >
        <button
            type="button"
            data-scroll-target="main"
            class="text-sm font-semibold tracking-[0.12em] text-text"
            aria-label="Back to top"
        >
            FZ<span class="text-royal">.</span>
        </button>

        <div class="flex items-center gap-4 text-sm text-secondary sm:gap-6">
            <button
                type="button"
                data-scroll-target="work"
                data-nakhwa-trigger
                class="transition-colors duration-500 hover:text-text"
            >
                Work
            </button>

            <button
                type="button"
                data-scroll-target="experience"
                class="transition-colors duration-500 hover:text-text"
            >
                Experience
            </button>

            <button
                type="button"
                data-command-palette-trigger
                aria-label="Open command palette"
                aria-controls="command-palette"
                class="hidden rounded-sm border border-border px-2 py-1 text-xs text-muted transition-colors duration-500 hover:border-pewter hover:text-text lg:inline"
            >
                ⌘K
            </button>

            <ThemeToggle />
        </div>
    </nav>
</header>

<script>
    /*
     * Bind this handler once.
     *
     * Internal section navigation uses buttons instead
     * of URL hashes, so:
     *
     * localhost:4321/
     *
     * stays exactly that.
     */
    if (!document.documentElement.dataset.sectionNavigationBound) {
        document.documentElement.dataset.sectionNavigationBound = "true";

        document.addEventListener("click", (event) => {
            const target = event.target;

            if (!(target instanceof Element)) {
                return;
            }

            const trigger = target.closest<HTMLElement>("[data-scroll-target]");

            if (!trigger) {
                return;
            }

            const targetId = trigger.dataset.scrollTarget;

            if (!targetId) {
                return;
            }

            const section = document.getElementById(targetId);

            if (!section) {
                return;
            }

            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            /*
             * No location.hash.
             * No history.pushState.
             * No reload.
             *
             * Just scroll.
             */
            section.scrollIntoView({
                behavior: reducedMotion ? "auto" : "smooth",

                block: "start",
            });
        });
    }
</script>
