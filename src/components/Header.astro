---
import ThemeToggle from "./ThemeToggle.astro";
---

<header
    class="sticky top-0 z-30 border-b border-paper/10 bg-ink/90 backdrop-blur-sm"
>
    <nav
        class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 lg:pr-12"
        aria-label="Primary navigation"
    >
        <a
            href="/"
            class="font-mono text-sm font-semibold tracking-widest"
            aria-label="Home"
        >
            FZ<span class="text-accent-cyan">.</span>
        </a>

        <div class="flex items-center gap-5 text-sm text-paper/70">
            <button
                type="button"
                data-scroll-target="work"
                class="transition-colors hover:text-accent-cyan"
            >
                Work
            </button>

            <button
                type="button"
                data-scroll-target="governance"
                class="transition-colors hover:text-accent-cyan"
            >
                Governance
            </button>

            <button
                type="button"
                data-command-palette-trigger
                aria-label="Open command palette"
                aria-controls="command-palette"
                class="hidden rounded border border-paper/10 px-1.5 py-0.5 font-mono text-xs text-paper/45 transition-colors hover:border-accent-cyan hover:text-accent-cyan lg:inline"
            >
                ⌘K
            </button>

            <ThemeToggle />
        </div>
    </nav>
</header>

<script>
    document.addEventListener("click", (event) => {
        const target = event.target;

        if (!(target instanceof Element)) {
            return;
        }

        const trigger = target.closest<HTMLElement>("[data-scroll-target]");

        if (!trigger) {
            return;
        }

        const sectionId = trigger.dataset.scrollTarget;

        if (!sectionId) {
            return;
        }

        const section = document.getElementById(sectionId);

        if (!section) {
            return;
        }

        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        section.scrollIntoView({
            behavior: reducedMotion ? "auto" : "smooth",
            block: "start",
        });
    });
</script>
