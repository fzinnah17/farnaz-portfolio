---
import ThemeToggle from "./ThemeToggle.astro";
---

<header
    class="sticky top-0 z-30 border-b border-border bg-bg/95 backdrop-blur-sm"
>
    <nav
        class="mx-auto flex h-16 max-w-[1100px] items-center justify-between px-6"
        aria-label="Primary navigation"
    >
        <a
            href="/"
            class="text-sm font-semibold tracking-[0.12em] text-text"
            aria-label="Home"
        >
            FZ<span class="text-accent-strong">.</span>
        </a>

        <div class="flex items-center gap-4 text-sm text-secondary sm:gap-6">
            <a
                href="#work"
                class="transition-colors duration-500 hover:text-text"
            >
                Work
            </a>

            <a
                href="#perspective"
                class="hidden transition-colors duration-500 hover:text-text sm:inline"
            >
                Perspective
            </a>

            <a
                href="#experience"
                class="hidden transition-colors duration-500 hover:text-text md:inline"
            >
                Experience
            </a>

            <button
                type="button"
                data-command-palette-trigger
                aria-label="Open command palette"
                aria-controls="command-palette"
                class="hidden rounded-sm border border-border px-2 py-1 text-xs text-muted transition-colors duration-500 hover:border-accent hover:text-text lg:inline"
            >
                ⌘K
            </button>

            <ThemeToggle />
        </div>
    </nav>
</header>
