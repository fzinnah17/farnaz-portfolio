---
const links = [
  {
    label: "Mail",
    href: "mailto:farnazsamia@gmail.com",
    external: false,
  },
  {
    label: "GitHub",
    href: "https://github.com/fzinnah17",
    external: true,
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/farnaz-zinnah",
    external: true,
  },
];
---

<nav
  aria-label="Contact links"
  class="fixed right-6 top-1/2 z-40 hidden -translate-y-1/2 flex-col items-center gap-5 font-mono text-xs uppercase tracking-widest lg:flex"
>
  <div class="h-10 w-px bg-white/15"></div>

  {
    links.map((link) => (
      <a
        href={link.href}
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener noreferrer" : undefined}
        class="text-paper/50 transition-colors hover:text-accent-cyan [writing-mode:vertical-rl]"
      >
        {link.label}
      </a>
    ))
  }

  <div class="h-10 w-px bg-white/15"></div>
</nav>

<nav
  aria-label="Contact links"
  class="fixed inset-x-0 bottom-0 z-40 flex justify-around border-t border-white/10 bg-ink/95 px-2 py-3 font-mono text-[11px] uppercase tracking-wider backdrop-blur-sm lg:hidden"
>
  {
    links.map((link) => (
      <a
        href={link.href}
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener noreferrer" : undefined}
        class="px-2 text-paper/60 transition-colors hover:text-accent-cyan"
      >
        {link.label}
      </a>
    ))
  }
</nav>
