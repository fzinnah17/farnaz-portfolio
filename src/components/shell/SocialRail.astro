---
import Icon from "../icons/Icon.astro";

const resumeUrl =
    "https://drive.google.com/file/d/1VfW9aVQ5eDtf3fz8kqHcRDLErVyC2w0L/view?usp=drive_link";

const links = [
    {
        label: "Email",
        href: "mailto:farnazsamia@gmail.com",
        icon: "mail",
    },
    {
        label: "GitHub",
        href: "https://github.com/fzinnah17",
        icon: "code",
    },
    {
        label: "LinkedIn",
        href: "https://linkedin.com/in/farnaz-zinnah",
        icon: "link",
    },
    {
        label: "Resume",
        href: resumeUrl,
        icon: "document",
    },
] as const;
---

<nav
    aria-label="Contact and resume links"
    class="fixed right-5 top-1/2 z-40 hidden -translate-y-1/2 lg:block"
>
    <ul class="flex flex-col gap-2">
        {
            links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        target={
                            link.href.startsWith("http") ? "_blank" : undefined
                        }
                        rel={
                            link.href.startsWith("http")
                                ? "noopener noreferrer"
                                : undefined
                        }
                        class="group flex min-h-[44px] items-center gap-2.5 rounded-full border border-border bg-bg/95 px-3.5 text-text backdrop-blur-sm transition-colors hover:border-accent-cyan"
                    >
                        <Icon
                            name={link.icon}
                            class="h-4 w-4 shrink-0 text-accent-cyan"
                        />

                        <span class="whitespace-nowrap font-mono text-sm">
                            {link.label}
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<nav
    aria-label="Contact and resume links"
    class="fixed inset-x-0 bottom-0 z-40 flex justify-around border-t border-border bg-bg/95 py-2 pb-[calc(env(safe-area-inset-bottom)+0.5rem)] backdrop-blur-sm lg:hidden"
>
    {
        links.map((link) => (
            <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={
                    link.href.startsWith("http")
                        ? "noopener noreferrer"
                        : undefined
                }
                class="flex min-h-[44px] min-w-[64px] flex-col items-center justify-center gap-1 text-secondary transition-colors hover:text-accent-cyan"
            >
                <Icon name={link.icon} class="h-5 w-5" />

                <span class="font-mono text-[10px] uppercase tracking-wide">
                    {link.label}
                </span>
            </a>
        ))
    }
</nav>
