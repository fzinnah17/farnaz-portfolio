    <p class="font-mono text-xs tracking-wide text-secondary">
        Crafted by Farnaz Zinnah

        <span aria-hidden="true"> · </span>

        © 2026

        <span class="text-accent-gold" aria-hidden="true"> ♥ </span>
    </p>

    <p class="mt-1 font-mono text-[11px] text-muted">
        build {buildDate}
    </p>
</footer>
