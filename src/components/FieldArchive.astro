  /*
   * ==================================================
   * REDUCED MOTION
   *
   * The archive simply appears.
   * No functionality is lost.
   * ==================================================
   */

  @media (
    prefers-reduced-motion:
      reduce
  ) {
    .field-archive,
    .archive-panel,
    .archive-photo,
    .archive-ceremonial-line,
    .archive-control-button {
      animation:
        none !important;

      transition:
        none !important;
    }

    .field-archive[data-motion="ready"]
      .archive-ceremonial-line {
      transform:
        scaleX(
          1
        );
    }

    .field-archive[data-motion="ready"]
      .archive-panel {
      translate:
        0
        0;
    }

    .archive-panel:hover
      .archive-photo {
      transform:
        none;
    }
  }
</style>

<script>
  const archiveSection =
    document.querySelector<HTMLElement>(
      "[data-field-archive]",
    );

  if (archiveSection) {
    const scroller =
      archiveSection.querySelector<HTMLElement>(
        "[data-archive-scroll]",
      );

    const panels =
      Array.from(
        archiveSection.querySelectorAll<HTMLElement>(
          "[data-archive-panel]",
        ),
      );

    const previousButton =
      archiveSection.querySelector<HTMLButtonElement>(
        "[data-archive-prev]",
      );

    const nextButton =
      archiveSection.querySelector<HTMLButtonElement>(
        "[data-archive-next]",
      );

    const currentLabel =
      archiveSection.querySelector<HTMLElement>(
        "[data-archive-current]",
      );

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

    let currentIndex = 0;
    let scrollFrame = 0;

    function getBehavior():
      ScrollBehavior {
      return reducedMotion.matches
        ? "auto"
        : "smooth";
    }

    function clampIndex(
      index: number,
    ) {
      return Math.max(
        0,
        Math.min(
          index,
          panels.length - 1,
        ),
      );
    }

    function updateControls(
      index: number,
    ) {
      currentIndex =
        clampIndex(
          index,
        );

      if (currentLabel) {
        currentLabel.textContent =
          String(
            currentIndex + 1,
          ).padStart(
            2,
            "0",
          );
      }

      if (previousButton) {
        previousButton.disabled =
          currentIndex === 0;
      }

      if (nextButton) {
        nextButton.disabled =
          currentIndex ===
          panels.length - 1;
      }
    }

    function goToPanel(
      index: number,
    ) {
      if (!scroller) {
        return;
      }

      const nextIndex =
        clampIndex(
          index,
        );

      const panel =
        panels[
          nextIndex
        ];

      if (!panel) {
        return;
      }

      /*
       * Scroll only the archive itself.
       *
       * Using scrollTo rather than scrollIntoView
       * prevents the whole page from unexpectedly
       * moving vertically.
       */
      scroller.scrollTo({
        left:
          panel.offsetLeft,
        behavior:
          getBehavior(),
      });

      updateControls(
        nextIndex,
      );
    }

    previousButton?.addEventListener(
      "click",
      () => {
        goToPanel(
          currentIndex - 1,
        );
      },
    );

    nextButton?.addEventListener(
      "click",
      () => {
        goToPanel(
          currentIndex + 1,
        );
      },
    );

    /*
     * Keyboard navigation lives on the archive region.
     *
     * The individual photo cards are deliberately
     * NOT separate Tab stops.
     */
    scroller?.addEventListener(
      "keydown",
      (event) => {
        if (
          event.key ===
          "ArrowRight"
        ) {
          event.preventDefault();

          goToPanel(
            currentIndex + 1,
          );

          return;
        }

        if (
          event.key ===
          "ArrowLeft"
        ) {
          event.preventDefault();

          goToPanel(
            currentIndex - 1,
          );

          return;
        }

        if (
          event.key ===
          "Home"
        ) {
          event.preventDefault();

          goToPanel(
            0,
          );

          return;
        }

        if (
          event.key ===
          "End"
        ) {
          event.preventDefault();

          goToPanel(
            panels.length - 1,
          );
        }
      },
    );

    /*
     * Keep the counter synchronized with
     * mouse-wheel, trackpad and touch scrolling.
     */
    scroller?.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(
          scrollFrame,
        );

        scrollFrame =
          requestAnimationFrame(
            () => {
              if (!scroller) {
                return;
              }

              let closestIndex =
                0;

              let closestDistance =
                Number.POSITIVE_INFINITY;

              panels.forEach(
                (
                  panel,
                  index,
                ) => {
                  const distance =
                    Math.abs(
                      panel.offsetLeft -
                        scroller.scrollLeft,
                    );

                  if (
                    distance <
                    closestDistance
                  ) {
                    closestDistance =
                      distance;

                    closestIndex =
                      index;
                  }
                },
              );

              updateControls(
                closestIndex,
              );
            },
          );
      },
      {
        passive: true,
      },
    );

    /*
     * --------------------------------------------------
     * CEREMONIAL OPENING
     * --------------------------------------------------
     *
     * One short decorative entrance.
     * No autoplay afterward.
     */
    if (
      !reducedMotion.matches
    ) {
      archiveSection.dataset.motion =
        "ready";

      const observer =
        new IntersectionObserver(
          (
            entries,
            archiveObserver,
          ) => {
            const entry =
              entries[0];

            if (
              !entry?.isIntersecting
            ) {
              return;
            }

            archiveSection.dataset.entered =
              "true";

            archiveObserver.disconnect();
          },
          {
            threshold:
              0.2,
          },
        );

      observer.observe(
        archiveSection,
      );
    } else {
      archiveSection.dataset.entered =
        "true";
    }

    updateControls(
      0,
    );
  }
</script>