---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import hackathonWorking from "../assets/portfolio/archive/01-hackathon-working.jpeg";
import microsoftPhoto from "../assets/portfolio/archive/02-microsoft.jpeg";
import sweGroup from "../assets/portfolio/archive/03-swe-group.jpeg";
import conferencePanel from "../assets/portfolio/archive/04-conference-panel.jpeg";
import hackathonTeam from "../assets/portfolio/archive/05-hackathon-team.jpeg";
import mitPhoto from "../assets/portfolio/archive/06-mit.jpeg";
import womenTechGroup from "../assets/portfolio/archive/07-women-tech-group.jpeg";
import swePhotoStrip from "../assets/portfolio/archive/08-swe-photo-strip.jpeg";
import mongodbPhoto from "../assets/portfolio/archive/09-mongodb.jpeg";
import hbsPhoto from "../assets/portfolio/archive/10-harvard-business-school.jpeg";

type ArchiveSize =
  | "wide"
  | "standard"
  | "narrow"
  | "portrait";

type ImageMode =
  | "scene"
  | "portrait"
  | "record";

interface ArchiveItem {
  number: string;
  register: string;
  title: string;
  note: string;
  image: ImageMetadata;
  alt: string;
  size: ArchiveSize;
  imageMode: ImageMode;
  focalPoint?: string;
  breakProtocol?: boolean;
}

const archive: ArchiveItem[] = [
  {
    number: "01",
    register: "Build",
    title: "In the work",
    note: "Hackathon build session.",
    image: hackathonWorking,
    alt: "Farnaz working with teammates at a hackathon table",
    size: "wide",
    imageMode: "scene",
    focalPoint: "center center",
  },
  {
    number: "02",
    register: "Industry",
    title: "Microsoft",
    note: "Learning beyond the day-to-day.",
    image: microsoftPhoto,
    alt: "Farnaz standing in front of a Microsoft sign",
    size: "standard",
    imageMode: "record",
  },
  {
    number: "03",
    register: "Community",
    title: "SWE",
    note: "Engineering in company.",
    image: sweGroup,
    alt: "Large group photo at a Society of Women Engineers event",
    size: "wide",
    imageMode: "scene",
    focalPoint: "center center",
  },
  {
    number: "04",
    register: "Exchange",
    title: "Ideas in circulation",
    note: "Technical conversations beyond the screen.",
    image: conferencePanel,
    alt: "Professional conference panel on a blue-lit stage",
    size: "standard",
    imageMode: "scene",
    focalPoint: "center center",
    breakProtocol: true,
  },
  {
    number: "05",
    register: "Team",
    title: "From problem to prototype",
    note: "Building collaboratively under a deadline.",
    image: hackathonTeam,
    alt: "Farnaz with a hackathon team beside their project",
    size: "standard",
    imageMode: "scene",
    focalPoint: "center center",
  },
  {
    number: "06",
    register: "Learning",
    title: "MIT",
    note: "Curiosity outside the boundaries of work.",
    image: mitPhoto,
    alt: "Farnaz seated outside Massachusetts Institute of Technology",
    size: "portrait",
    imageMode: "portrait",
    focalPoint: "center 42%",
  },
  {
    number: "07",
    register: "Community",
    title: "In the room",
    note: "The people behind the technical work.",
    image: womenTechGroup,
    alt: "Farnaz with a professional group at an engineering event",
    size: "wide",
    imageMode: "scene",
    focalPoint: "center center",
  },
  {
    number: "08",
    register: "Record",
    title: "SWE 2025",
    note: "A small artifact from the larger experience.",
    image: swePhotoStrip,
    alt: "SWE 2025 professional event record featuring Farnaz",
    size: "narrow",
    imageMode: "record",
  },
  {
    number: "09",
    register: "Developer",
    title: "MongoDB",
    note: "Meeting the broader developer community.",
    image: mongodbPhoto,
    alt: "Farnaz at a MongoDB developer event",
    size: "standard",
    imageMode: "record",
  },
  {
    number: "10",
    register: "Learning",
    title: "Harvard Business School",
    note: "Looking beyond engineering alone.",
    image: hbsPhoto,
    alt: "Farnaz standing outside Harvard Business School",
    size: "portrait",
    imageMode: "record",
  },
];

const totalRecords = archive.length;
---

<section
  id="field-archive"
  data-field-archive
  class="field-archive mx-auto max-w-6xl scroll-mt-24 px-6 lg:pr-12"
  aria-labelledby="field-archive-title"
>
  <!-- ==================================================
       FIELD ARCHIVE / 03
  ================================================== -->
  <header
    class="archive-header grid border-y border-border md:grid-cols-[0.72fr_1.28fr]"
  >
    <div
      class="border-b border-border px-5 py-6 md:border-b-0 md:border-r"
    >
      <p
        class="text-[11px] uppercase tracking-[0.2em] text-royal"
      >
        Field Archive / 03
      </p>

      <h2
        id="field-archive-title"
        class="mt-2 font-display text-3xl font-normal text-text md:text-4xl"
      >
        Beyond the work.
      </h2>

      <!-- NAKHWA / REFLECTION MOTIF -->
      <div
        class="archive-reflection mt-4"
        aria-hidden="true"
      >
        <span></span>
        <span></span>
      </div>
    </div>

    <div
      class="flex items-center justify-between gap-8 px-5 py-6"
    >
      <p
        class="max-w-lg text-[15px] leading-7 text-secondary"
      >
        Hackathons, professional communities, workshops, and the rooms where
        technical work becomes something shared.
      </p>

      <div
        class="hidden shrink-0 items-center gap-3 md:flex"
        aria-hidden="true"
      >
        <span class="h-px w-12 bg-border"></span>

        <span
          class="h-2 w-2 rotate-45 border border-royal"
        ></span>

        <span
          class="text-[11px] uppercase tracking-[0.18em] text-pewter"
        >
          FZ / Field Record
        </span>
      </div>
    </div>
  </header>

  <!-- ==================================================
       ACCESSIBLE COURT REGISTER
  ================================================== -->
  <div
    class="archive-controls mt-5 grid gap-4 border-y px-4 py-3 sm:grid-cols-[1fr_auto] sm:items-center"
  >
    <div
      class="flex flex-wrap items-center gap-x-4 gap-y-2"
    >
      <p
        class="text-[11px] font-medium uppercase tracking-[0.18em] text-pewter"
      >
        Court Register
      </p>

      <span
        aria-hidden="true"
        class="h-px w-10 bg-border"
      ></span>

      <p
        class="font-mono text-[12px] tracking-[0.1em] text-secondary"
        aria-live="polite"
        aria-atomic="true"
      >
        Record
        <span data-archive-current>01</span>
        of
        {String(totalRecords).padStart(2, "0")}
      </p>
    </div>

    <div
      class="flex items-center gap-2"
      aria-label="Field archive navigation"
    >
      <button
        type="button"
        data-archive-prev
        aria-controls="field-archive-scroll"
        class="archive-control-button"
        aria-label="View previous field archive record"
      >
        <span aria-hidden="true">
          ←
        </span>

        <span>
          Previous
        </span>
      </button>

      <button
        type="button"
        data-archive-next
        aria-controls="field-archive-scroll"
        class="archive-control-button"
        aria-label="View next field archive record"
      >
        <span>
          Next
        </span>

        <span aria-hidden="true">
          →
        </span>
      </button>
    </div>
  </div>

  <p
    id="field-archive-instructions"
    class="archive-instructions mt-3 text-[12px] leading-5 text-muted"
  >
    Browse with Previous/Next, arrow keys, trackpad, or swipe.
  </p>

  <!-- ==================================================
       FOLDING-SCREEN STAGE
  ================================================== -->
  <div class="archive-stage relative mt-4">
    <!-- CEREMONIAL OPENING RULE -->
    <div
      class="archive-ceremonial-line"
      aria-hidden="true"
    ></div>

    <!-- FORMAL RANK MARK -->
    <div
      class="archive-rank-mark"
      aria-hidden="true"
    >
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div
      id="field-archive-scroll"
      data-archive-scroll
      class="archive-scroll"
      tabindex="0"
      role="region"
      aria-label="Professional field archive"
      aria-describedby="field-archive-instructions"
    >
      <div class="archive-track">
        {
          archive.map((item, index) => (
            <article
              class="archive-panel"
              data-archive-panel
              data-index={index}
              data-size={item.size}
              data-image-mode={item.imageMode}
              data-break={item.breakProtocol ? "true" : "false"}
              role="group"
              aria-labelledby={`archive-title-${item.number}`}
              style={`--archive-object-position: ${item.focalPoint ?? "center center"};`}
            >
              <!-- HUI-JU / OXBLOOD INTERRUPTION -->
              <span
                class="archive-corner archive-corner-x"
                aria-hidden="true"
              ></span>

              <span
                class="archive-corner archive-corner-y"
                aria-hidden="true"
              ></span>

              <!-- FOLDING-SCREEN HINGES -->
              <div
                class="archive-hinges"
                aria-hidden="true"
              >
                <span></span>
                <span></span>
              </div>

              <!-- PHOTO -->
              <div class="archive-image">
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={[420, 640, 840, 1000]}
                  sizes="(max-width: 640px) 82vw, 22rem"
                  loading="lazy"
                  class="archive-photo"
                />

                <span
                  class="archive-photo-number"
                  aria-hidden="true"
                >
                  {item.number}
                </span>
              </div>

              <!-- ALWAYS-VISIBLE RECORD -->
              <div class="archive-caption">
                <div
                  class="flex items-start justify-between gap-4"
                >
                  <div class="min-w-0">
                    <p
                      class="archive-category"
                    >
                      {item.number} / {item.register}
                    </p>

                    <h3
                      id={`archive-title-${item.number}`}
                      class="archive-title mt-1"
                    >
                      {item.title}
                    </h3>
                  </div>

                  <span
                    class="archive-register-mark"
                    aria-hidden="true"
                  ></span>
                </div>

                <p
                  class="archive-note mt-2"
                >
                  {item.note}
                </p>

                <div
                  class="archive-caption-reflection mt-3"
                  aria-hidden="true"
                >
                  <span></span>
                  <span></span>
                </div>
              </div>
            </article>
          ))
        }

        <!-- END REGISTER -->
        <div
          class="archive-end"
          aria-hidden="true"
        >
          <div>
            <p>
              End / {String(totalRecords).padStart(2, "0")}
            </p>

            <span></span>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT-SIDE DISCOVERY FADE -->
    <div
      class="archive-edge-right"
      aria-hidden="true"
    ></div>
  </div>
</section>

<style>
  /*
   * ==================================================
   * FIELD ARCHIVE
   *
   * PERFECT CROWN VISUAL SYSTEM
   *
   * - modern content inside formal structure
   * - folding-screen vertical bays
   * - court-register ordering
   * - oxblood controlled disruption
   * - pewter hinges
   * - reflection lines
   * - one subtle protocol break
   * - ceremonial opening motion
   *
   * ACCESSIBILITY
   *
   * - no autoplay
   * - no hover-only information
   * - no card height changes
   * - large functional typography
   * - keyboard navigation
   * - reduced motion supported
   * - cards are not unnecessary Tab stops
   * ==================================================
   */

  .field-archive {
    position: relative;
  }

  /*
   * ==================================================
   * HEADER
   * ==================================================
   */

  .archive-header {
    background:
      color-mix(
        in srgb,
        var(--theme-surface) 24%,
        transparent
      );
  }

  /*
   * Reflection motif.
   */
  .archive-reflection {
    display: flex;

    width: 8rem;

    flex-direction: column;

    gap: 3px;
  }

  .archive-reflection span:first-child {
    width: 100%;
    height: 1px;

    background:
      color-mix(
        in srgb,
        var(--theme-royal) 70%,
        var(--theme-border)
      );
  }

  .archive-reflection span:last-child {
    width: 64%;
    height: 1px;

    margin-left: 18%;

    opacity: 0.32;

    background:
      var(--theme-royal);
  }

  /*
   * ==================================================
   * COURT REGISTER / CONTROLS
   * ==================================================
   */

  .archive-controls {
    border-color:
      var(--theme-border);

    background:
      color-mix(
        in srgb,
        var(--theme-surface) 42%,
        transparent
      );
  }

  .archive-control-button {
    display: inline-flex;

    min-height: 44px;

    align-items: center;

    justify-content: center;

    gap: 0.5rem;

    border:
      1px solid
      var(--theme-border);

    padding:
      0.55rem
      0.85rem;

    background:
      transparent;

    font-size:
      0.875rem;

    line-height:
      1.25rem;

    color:
      var(--theme-text-secondary);

    transition:
      border-color 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .archive-control-button:hover {
    border-color:
      var(--theme-pewter);

    color:
      var(--theme-text);

    background:
      color-mix(
        in srgb,
        var(--theme-surface) 70%,
        transparent
      );
  }

  .archive-control-button:focus-visible {
    outline:
      2px solid
      var(--theme-royal);

    outline-offset:
      3px;
  }

  .archive-control-button:disabled {
    opacity: 0.42;

    cursor: not-allowed;
  }

  /*
   * ==================================================
   * FIXED ARCHIVE STAGE
   * ==================================================
   */

  .archive-stage {
    height: 30rem;

    overflow: hidden;

    border-bottom:
      1px solid
      var(--theme-border);

    background:
      color-mix(
        in srgb,
        var(--theme-bg) 80%,
        var(--theme-surface)
      );
  }

  /*
   * Ceremonial oxblood line.
   *
   * This is the one entrance animation.
   */
  .archive-ceremonial-line {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;

    z-index: 12;

    height: 2px;

    transform-origin:
      left center;

    background:
      linear-gradient(
        to right,
        var(--theme-royal),
        color-mix(
          in srgb,
          var(--theme-royal) 54%,
          var(--theme-pewter)
        ),
        transparent
      );
  }

  /*
   * Three-line formal rank marker.
   */
  .archive-rank-mark {
    position: absolute;

    left: 0;
    top: -6px;

    z-index: 14;

    display: flex;

    gap: 3px;
  }

  .archive-rank-mark span {
    width: 1px;

    background:
      var(--theme-royal);
  }

  .archive-rank-mark span:nth-child(1) {
    height: 9px;
  }

  .archive-rank-mark span:nth-child(2) {
    height: 14px;
  }

  .archive-rank-mark span:nth-child(3) {
    height: 8px;
  }

  /*
   * ==================================================
   * SCROLL REGION
   * ==================================================
   */

  .archive-scroll {
    position: relative;

    height: 100%;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-snap-type:
      x mandatory;

    overscroll-behavior-inline:
      contain;

    scrollbar-width:
      thin;

    scrollbar-color:
      var(--theme-pewter)
      transparent;
  }

  .archive-scroll:focus-visible {
    outline:
      2px solid
      var(--theme-royal);

    outline-offset:
      -3px;
  }

  .archive-scroll::-webkit-scrollbar {
    height: 6px;
  }

  .archive-scroll::-webkit-scrollbar-track {
    background:
      transparent;
  }

  .archive-scroll::-webkit-scrollbar-thumb {
    background:
      var(--theme-pewter);
  }

  /*
   * ==================================================
   * FOLDING-SCREEN TRACK
   * ==================================================
   */

  .archive-track {
    display: flex;

    width: max-content;
    min-width: 100%;

    height: 100%;

    align-items: flex-start;

    padding:
      1rem
      4rem
      1.25rem
      0;

    gap: 0;
  }

  /*
   * ==================================================
   * INDIVIDUAL PANEL
   * ==================================================
   */

  .archive-panel {
    position: relative;

    display: flex;

    height: 27rem;

    flex: none;
    flex-direction: column;

    scroll-snap-align:
      start;

    border-top:
      1px solid
      var(--theme-border);

    border-bottom:
      1px solid
      var(--theme-border);

    border-left:
      1px solid
      var(--theme-border);

    background:
      var(--theme-surface);

    transition:
      transform 350ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        ),
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .archive-panel:last-of-type {
    border-right:
      1px solid
      var(--theme-border);
  }

  /*
   * Approximately three records plus the beginning
   * of a fourth at desktop width.
   */
  .archive-panel[data-size="wide"] {
    width: 22rem;
  }

  .archive-panel[data-size="standard"] {
    width: 18rem;
  }

  .archive-panel[data-size="narrow"] {
    width: 15rem;
  }

  .archive-panel[data-size="portrait"] {
    width: 16.5rem;
  }

  /*
   * One deliberate protocol break.
   */
  .archive-panel[data-break="true"] {
    transform:
      translateY(
        8px
      );
  }

  .archive-panel:hover {
    z-index: 5;

    border-color:
      color-mix(
        in srgb,
        var(--theme-pewter) 72%,
        var(--theme-border)
      );

    box-shadow:
      0 18px 40px
      rgba(
        18,
        18,
        20,
        0.07
      );
  }

  /*
   * ==================================================
   * FOLDING-SCREEN HINGES
   * ==================================================
   */

  .archive-hinges {
    position: absolute;

    right: -4px;
    top: 0;
    bottom: 0;

    z-index: 15;

    width: 8px;

    pointer-events: none;
  }

  .archive-hinges::before {
    content: "";

    position: absolute;

    left: 3px;
    top: 0;
    bottom: 0;

    width: 1px;

    background:
      color-mix(
        in srgb,
        var(--theme-pewter) 60%,
        var(--theme-border)
      );
  }

  .archive-hinges span {
    position: absolute;

    left: 1px;

    width: 6px;
    height: 6px;

    transform:
      rotate(
        45deg
      );

    border:
      1px solid
      var(--theme-pewter);

    background:
      var(--theme-surface);
  }

  .archive-hinges span:first-child {
    top: 28%;
  }

  .archive-hinges span:last-child {
    bottom: 28%;
  }

  /*
   * Stronger oxblood hinge on the panel
   * that breaks protocol.
   */
  .archive-panel[data-break="true"]
    .archive-hinges span:first-child {
    border-color:
      var(--theme-royal);
  }

  /*
   * ==================================================
   * CONTROLLED RED CORNER
   * ==================================================
   */

  .archive-corner {
    position: absolute;

    left: -1px;
    top: -1px;

    z-index: 16;

    background:
      var(--theme-royal);

    opacity: 0.72;

    pointer-events: none;
  }

  .archive-corner-x {
    width: 2.35rem;
    height: 1px;
  }

  .archive-corner-y {
    width: 1px;
    height: 2.35rem;
  }

  .archive-panel[data-break="true"]
    .archive-corner {
    opacity: 1;
  }

  .archive-panel[data-break="true"]
    .archive-corner-x {
    width: 3.25rem;
  }

  .archive-panel[data-break="true"]
    .archive-corner-y {
    height: 3.25rem;
  }

  /*
   * ==================================================
   * IMAGE AREA
   * ==================================================
   */

  .archive-image {
    position: relative;

    min-height: 0;

    flex: 1;

    overflow: hidden;

    border-bottom:
      1px solid
      var(--theme-border);

    background:
      color-mix(
        in srgb,
        var(--theme-bg) 76%,
        var(--theme-surface)
      );
  }

  .archive-photo {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position:
      var(
        --archive-object-position
      );

    filter:
      saturate(0.92)
      contrast(1.018);

    transition:
      transform 550ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        ),
      filter 350ms ease;
  }

  /*
   * SCENE
   *
   * Context can crop slightly.
   */
  .archive-panel[data-image-mode="scene"]
    .archive-photo {
    object-fit: cover;
  }

  /*
   * PORTRAIT
   *
   * Keep the person dominant while respecting
   * the custom focal point.
   */
  .archive-panel[data-image-mode="portrait"]
    .archive-photo {
    object-fit: cover;
  }

  /*
   * RECORD
   *
   * Logos, signs and artifacts are evidence.
   * Show the complete photograph.
   */
  .archive-panel[data-image-mode="record"]
    .archive-image {
    padding:
      0.7rem;

    background:
      color-mix(
        in srgb,
        var(--theme-bg) 64%,
        var(--theme-surface)
      );
  }

  .archive-panel[data-image-mode="record"]
    .archive-photo {
    object-fit: contain;
  }

  /*
   * Hover is purely decorative.
   */
  .archive-panel:hover
    .archive-photo {
    transform:
      scale(
        1.01
      );

    filter:
      saturate(1)
      contrast(1.018);
  }

  .archive-panel[data-image-mode="record"]:hover
    .archive-photo {
    transform: none;
  }

  /*
   * ==================================================
   * PHOTO NUMBER
   * ==================================================
   */

  .archive-photo-number {
    position: absolute;

    right: 0.75rem;
    top: 0.75rem;

    z-index: 6;

    min-width: 2rem;

    padding:
      0.28rem
      0.38rem;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--theme-border) 70%,
        transparent
      );

    background:
      color-mix(
        in srgb,
        var(--theme-bg) 86%,
        transparent
      );

    backdrop-filter:
      blur(
        5px
      );

    text-align: center;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size:
      0.68rem;

    letter-spacing:
      0.1em;

    color:
      var(--theme-text);
  }

  /*
   * ==================================================
   * CAPTION
   *
   * Always visible.
   * Never depends on hover.
   * ==================================================
   */

  .archive-caption {
    min-height: 8.4rem;

    padding:
      0.9rem
      1rem
      1rem;

    background:
