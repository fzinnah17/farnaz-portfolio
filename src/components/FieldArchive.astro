      #f7f5f0;
  }

  :global(html:not(.dark))
    .archive-controls {
    border-color:
      #aaa39a;

    background:
      #e8e4dc;
  }

  :global(html:not(.dark))
    .archive-controls
    .bg-border {
    background:
      #9c958c;
  }

  :global(html:not(.dark))
    .archive-control-button {
    border-color:
      #9e978e;

    background:
      #f6f3ed;

    color:
      #2e3238;
  }

  :global(html:not(.dark))
    .archive-control-button:hover {
    border-color:
      var(--theme-royal);

    background:
      #fcfaf6;

    color:
      #151519;
  }

  :global(html:not(.dark))
    .archive-stage {
    border-color:
      #a9a298;

    background:
      #eae6de;
  }

  :global(html:not(.dark))
    .archive-panel {
    border-color:
      #9f988f;

    background:
      #fbfaf6;
  }

  :global(html:not(.dark))
    .archive-image {
    border-color:
      #aaa39a;

    background:
      #e9e5dd;
  }

  :global(html:not(.dark))
    .archive-panel[data-image-mode="record"]
    .archive-image {
    background:
      #e4e0d7;
  }

  :global(html:not(.dark))
    .archive-caption {
    background:
      #fbfaf6;
  }

  :global(html:not(.dark))
    .archive-hinges::before {
    background:
      #888178;
  }

  :global(html:not(.dark))
    .archive-hinges span {
    border-color:
      #777168;

    background:
      #f7f4ee;
  }

  :global(html:not(.dark))
    .archive-panel[data-break="true"]
    .archive-hinges span:first-child {
    border-color:
      var(--theme-royal);
  }

  :global(html:not(.dark))
    .archive-photo-number {
    border-color:
      #9d968c;

    background:
      rgba(
        250,
        248,
        243,
        0.92
      );
  }

  :global(html:not(.dark))
    .archive-edge-right {
    background:
      linear-gradient(
        to left,
        #f1efea,
        transparent
      );
  }

  /*
   * ==================================================
   * DARK MODE
   * ==================================================
   */

  :global(html.dark)
    .archive-stage {
    background:
      #090d14;
  }

  :global(html.dark)
    .archive-panel {
    background:
      color-mix(
        in srgb,
        var(--theme-surface) 72%,
        #080b12
      );
  }

  :global(html.dark)
    .archive-caption {
    background:
      #0e131b;
  }

  :global(html.dark)
    .archive-photo {
    filter:
      saturate(0.8)
      contrast(1.025)
      brightness(0.92);
  }

  :global(html.dark)
    .archive-panel:hover
    .archive-photo {
    filter:
      saturate(0.92)
      contrast(1.025)
      brightness(0.95);
  }

  :global(html.dark)
    .archive-panel[data-image-mode="record"]
    .archive-photo {
    filter:
      saturate(0.86)
      contrast(1.02)
      brightness(0.94);
  }

  /*
   * ==================================================
   * CEREMONIAL ENTRANCE
   *
   * Content remains visible.
   * Motion is decorative only.
   * ==================================================
   */

  .field-archive[data-motion="ready"]
    .archive-ceremonial-line {
    transform:
      scaleX(
        0
      );
  }

  .field-archive[data-motion="ready"]
    .archive-panel {
    translate:
      0
      6px;
  }

  .field-archive[data-motion="ready"][data-entered="true"]
    .archive-ceremonial-line {
    transform:
      scaleX(
        1
      );

    transition:
      transform
      420ms
      cubic-bezier(
        0.22,
        1,
        0.36,
        1
      );
  }

  .field-archive[data-motion="ready"][data-entered="true"]
    .archive-panel {
    translate:
      0
      0;

    transition:
      translate
      420ms
      cubic-bezier(
        0.22,
        1,
        0.36,
        1
      );
  }

  /*
   * Keep the intentional 04 protocol break.
   */
  .field-archive[data-motion="ready"][data-entered="true"]
    .archive-panel[data-break="true"] {
    transform:
      translateY(
        8px
      );
  }

  /*
   * ==================================================
   * TABLET
   * ==================================================
   */

  @media (
    max-width: 900px
  ) {
    .archive-stage {
      height:
        29rem;
    }

    .archive-panel,
    .archive-end {
      height:
        26rem;
    }

    .archive-panel[data-size="wide"] {
      width:
        20rem;
    }

    .archive-panel[data-size="standard"] {
      width:
        17rem;
    }

    .archive-panel[data-size="narrow"] {
      width:
        14.5rem;
    }

    .archive-panel[data-size="portrait"] {
      width:
        15.5rem;
    }

    .archive-caption {
      min-height:
        8.5rem;
    }
  }

  /*
   * ==================================================
   * MOBILE
   *
   * One main record plus a visible portion of the next.
   * ==================================================
   */

  @media (
    max-width: 640px
  ) {
    .archive-stage {
      height:
        29rem;
    }

    .archive-track {
      padding-right:
        1.75rem;
    }

    .archive-panel,
    .archive-end {
      height:
        26rem;
    }

    .archive-panel[data-size="wide"],
    .archive-panel[data-size="standard"],
    .archive-panel[data-size="narrow"],
